<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>500 - Server Error | PU NSS Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="card" style="text-align: center; max-width: 500px; padding: 40px;">
      <h1 style="font-size: 4rem; color: var(--nss-red); margin: 0;">500</h1>
      <h2 style="color: var(--nss-navy);">Internal Server Error</h2>
      <p style="color: var(--gray-600); margin-bottom: 25px;">An unexpected error occurred on our server. Please try again later.</p>
      <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
