<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 - Server Error | PU NSS Portal</title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
    <div class="track-card" style="text-align: center; max-width: 520px; width: 100%; padding: clamp(24px, 5vw, 45px) clamp(16px, 4vw, 35px);">
      <div style="margin-bottom: 10px; color: var(--color-nss-red);">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
      </div>
      <h1 style="font-size: clamp(2.5rem, 8vw, 3.5rem); color: var(--color-nss-red); font-weight: 800; margin: 0; line-height: 1;">500</h1>
      <h2 style="color: var(--color-navy); margin-top: 10px; margin-bottom: 10px; font-weight: 800; font-size: clamp(1.3rem, 4vw, 1.6rem);">Server Error</h2>
      <p style="color: var(--color-text-muted); font-size: clamp(0.88rem, 3vw, 0.95rem); margin-bottom: 24px; line-height: 1.5;">An unexpected error occurred while processing your request. Please try again later.</p>
      
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary" style="padding: 10px 20px; font-size: 0.92rem;">Return to Registration Form</a>
        <a href="/track-registration" class="btn btn-secondary" style="padding: 10px 20px; font-size: 0.92rem;">Track Status</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
