<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    .admin-profile-menu-box {
      display: none;
      position: absolute;
      right: 0;
      top: 120%;
      width: 220px;
      background: #ffffff !important;
      border-radius: 12px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.25) !important;
      border: 1px solid #cbd5e1 !important;
      z-index: 999999 !important;
      overflow: hidden;
      padding: 6px 0;
    }
    .admin-profile-menu-box.active-menu {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
    }
  </style>
  <script>
    window.toggleAdminProfileMenu = function(event) {
      if (event) {
        if (typeof event.stopPropagation === 'function') event.stopPropagation();
      }
      var menu = document.getElementById('profileDropdownMenu') || document.getElementById('adminProfileMenu') || document.getElementById('adminProfileMenuReg');
      if (menu) {
        if (menu.classList.contains('active-menu') || menu.style.display === 'block') {
          menu.classList.remove('active-menu');
          menu.style.display = 'none';
        } else {
          menu.classList.add('active-menu');
          menu.style.display = 'block';
        }
      }
    };

    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('profileDropdownBtn') || document.getElementById('adminProfileBtn') || document.getElementById('adminProfileBtnReg');
      if (btn) {
        btn.onclick = window.toggleAdminProfileMenu;
      }
    });

    document.addEventListener('click', function(e) {
      var menu = document.getElementById('profileDropdownMenu') || document.getElementById('adminProfileMenu') || document.getElementById('adminProfileMenuReg');
      var btn = document.getElementById('profileDropdownBtn') || document.getElementById('adminProfileBtn') || document.getElementById('adminProfileBtnReg');
      if (menu) {
        if (btn && btn.contains(e.target)) return;
        if (menu.contains(e.target)) return;
        menu.classList.remove('active-menu');
        menu.style.display = 'none';
      }
    });
  </script>
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh; background-color: var(--color-bg-light);">

  <!-- Admin Top Navigation Bar -->
  <header class="site-header" style="background: var(--color-navy); border-bottom: 3px solid var(--color-nss-red);">
    <div class="container header-inner" style="display: flex; justify-content: space-between; align-items: center;">
      <div class="logo-area" style="display: flex; align-items: center; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.9); padding: 4px 8px; border-radius: 8px;">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 38px; width: auto; object-fit: contain;">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 38px; width: auto; object-fit: contain; border-radius: 50%;">
        </div>
        <div class="logo-text" style="color: #ffffff;">
          Admin Control Center
          <small style="display: block; color: rgba(255, 255, 255, 0.8);">Pondicherry University Wing</small>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 15px;">
        <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="margin-right: 8px;">← Dashboard</a>
        <a href="/admin/registrations" class="btn btn-primary btn-sm" style="margin-right: 8px;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg> Registrations</a>
        
        <!-- Admin Profile Avatar Menu -->
        <div style="position: relative; display: inline-block;">
          <button id="profileDropdownBtn" type="button" onclick="toggleAdminProfileMenu(event)" style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.18); color: #fff; border: 1px solid rgba(255, 255, 255, 0.35); padding: 6px 14px; border-radius: 20px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--color-nss-red, #b71c1c); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">
              A
            </div>
            <span style="font-size: 0.88rem; color: #ffffff;">Welcome, <strong>Admin</strong></span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </button>

          <div id="profileDropdownMenu" class="admin-profile-menu-box" style="display: none; position: absolute; right: 0; top: 120%; width: 220px; background: #ffffff; border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,0.2); border: 1px solid #cbd5e1; z-index: 99999; overflow: hidden; padding: 6px 0;">
            <div style="padding: 10px 16px; border-bottom: 1px solid #f1f5f9; background: #f8fafc;">
              <div style="font-weight: 700; color: #0f172a; font-size: 0.88rem;">Admin</div>
            </div>
            <a href="/admin/change-password" style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; color: #0f172a; text-decoration: none; font-size: 0.88rem; font-weight: 600; background: #f1f5f9;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg> Change Password
            </a>
            <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; color: #b71c1c; text-decoration: none; font-size: 0.88rem; font-weight: 600; border-top: 1px solid #f1f5f9;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" /></svg> Logout
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 40px; padding-bottom: 60px; max-width: 540px;">
    
    <div style="background: #ffffff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid var(--color-border); padding: 35px 30px;">
      
      <div style="text-align: center; margin-bottom: 25px;">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; color: var(--color-nss-red); display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 12px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>
        </div>
        <h2 style="color: var(--color-navy); margin: 0; font-size: 1.4rem; font-weight: 800;">Change Admin Password</h2>
        <p style="color: var(--color-text-muted); font-size: 0.88rem; margin-top: 4px;">Update your password credentials directly from your dashboard</p>
      </div>

      <% if (locals.error && error) { %>
        <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 12px 16px; border-radius: 8px; font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 8px;">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
          <div><%= error %></div>
        </div>
      <% } %>

      <% if (locals.success && success) { %>
        <div class="alert alert-success" style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: 8px; font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid #16a34a; display: flex; align-items: center; gap: 8px;">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span>
          <div><%= success %></div>
        </div>
      <% } %>

      <form action="/admin/change-password" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="current_password" style="font-weight: 700; color: var(--color-text); display: block; margin-bottom: 6px; font-size: 0.88rem;">Current Password</label>
          <div class="input-container">
            <input type="password" id="current_password" name="current_password" class="form-control-custom" placeholder="Enter your current password" required autofocus>
            <span class="input-icon">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/>
              </svg>
            </span>
          </div>
        </div>

        <div class="form-group">
          <label for="new_password" style="font-weight: 700; color: var(--color-text); display: block; margin-bottom: 6px; font-size: 0.88rem;">New Password</label>
          <div class="input-container">
            <input type="password" id="new_password" name="new_password" class="form-control-custom" placeholder="Enter new password (min 6 chars)" required minlength="6">
            <span class="input-icon">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/>
              </svg>
            </span>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password" style="font-weight: 700; color: var(--color-text); display: block; margin-bottom: 6px; font-size: 0.88rem;">Confirm New Password</label>
          <div class="input-container">
            <input type="password" id="confirm_password" name="confirm_password" class="form-control-custom" placeholder="Re-enter new password" required minlength="6">
            <span class="input-icon">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/>
              </svg>
            </span>
          </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 10px;">
          <a href="/admin/dashboard" class="btn btn-secondary" style="flex: 1; justify-content: center;">Cancel</a>
          <button type="submit" class="btn btn-primary" style="flex: 2; justify-content: center;">Update Password</button>
        </div>
      </form>

    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
  <script>
    function toggleAdminProfileMenu(event) {
      if (event) {
        event.stopPropagation();
        if (event.preventDefault) event.preventDefault();
      }
      const menu = document.getElementById('profileDropdownMenu') || document.getElementById('adminProfileMenu') || document.getElementById('adminProfileMenuReg');
      if (menu) {
        const isHidden = window.getComputedStyle(menu).display === 'none';
        menu.style.display = isHidden ? 'block' : 'none';
      }
    }

    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileDropdownMenu') || document.getElementById('adminProfileMenu') || document.getElementById('adminProfileMenuReg');
      if (menu && !menu.contains(e.target)) {
        menu.style.display = 'none';
      }
    });
  </script>
</body>
</html>
