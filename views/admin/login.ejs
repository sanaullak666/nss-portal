<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="card" style="max-width: 420px; width: 100%; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
      <div style="text-align: center; margin-bottom: 25px;">
        <h2 style="color: var(--color-navy); margin-bottom: 5px;">NSS Admin Portal</h2>
        <p style="color: var(--color-text-muted); font-size: 0.9rem;">Sign in to manage volunteer registrations</p>
      </div>

      <% if (error) { %>
        <div style="background: #fee2e2; color: #b71c1c; padding: 10px 15px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 20px; text-align: center;">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="form-group" style="margin-bottom: 18px;">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" placeholder="Enter admin username" required autofocus>
        </div>

        <div class="form-group" style="margin-bottom: 25px;">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" placeholder="Enter password" required>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Sign In</button>
      </form>
      
      <div style="text-align: center; margin-top: 20px;">
        <a href="/" style="font-size: 0.85rem; color: var(--color-text-muted);">← Back to Volunteer Portal</a>
      </div>
    </div>
  </main>
</body>
</html>
