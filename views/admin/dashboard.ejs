<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="dashboard-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <%- include('../partials/loader') %>

  <!-- Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <header class="site-header">
    <div class="header-inner container">
      <div class="logo-area" style="display: flex; align-items: center; gap: 12px;">
        <div class="header-logo-group" style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.9); padding: 4px 8px; border-radius: 8px; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 40px; width: auto; object-fit: contain;" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 4px;" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 50%;" title="National Service Scheme">
        </div>
        <div class="logo-text">
          Admin Analytics Portal
          <small style="display: block;">Pondicherry University</small>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 15px;">
        <!-- Admin Profile Avatar Dropdown -->
        <div style="position: relative; display: inline-block;">
          <button id="adminProfileBtn" type="button" style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.15); color: #fff; border: 1px solid rgba(255, 255, 255, 0.3); padding: 6px 14px; border-radius: 20px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--color-nss-red); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">
              <%= admin ? admin.fullName.charAt(0).toUpperCase() : 'A' %>
            </div>
            <span style="font-size: 0.88rem;">Welcome, <strong><%= admin ? admin.fullName : 'Admin' %></strong></span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </button>

          <div id="adminProfileMenu" style="display: none; position: absolute; right: 0; top: 115%; width: 220px; background: #ffffff; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); border: 1px solid #e2e8f0; z-index: 1000; overflow: hidden; padding: 6px 0;">
            <div style="padding: 10px 16px; border-bottom: 1px solid #f1f5f9; background: #f8fafc;">
              <div style="font-weight: 700; color: #1e293b; font-size: 0.88rem;"><%= admin ? admin.fullName : 'Admin' %></div>
              <div style="font-size: 0.78rem; color: #64748b;"><%= admin ? admin.email : 'admin@pondiuni.edu.in' %></div>
            </div>
            <a href="/admin/change-password" style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; color: #1e293b; text-decoration: none; font-size: 0.88rem; font-weight: 600; transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
              🔑 Change Password
            </a>
            <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; color: #b71c1c; text-decoration: none; font-size: 0.88rem; font-weight: 600; border-top: 1px solid #f1f5f9; transition: background 0.2s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='transparent'">
              🚪 Logout
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px;">
    
    <!-- Header Banner -->
    <div class="dashboard-title-box">
      <div>
        <h1>Volunteer Statistics & Dashboard</h1>
        <p>Real-time registration metrics across NSS Units</p>
      </div>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/admin/registrations" class="btn btn-secondary">📋 Manage Registrations</a>
        <a href="/admin/registrations/export/excel" class="btn btn-primary"><svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg> Export Complete Excel (.xlsx)</a>
      </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="dash-stats-grid">
      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-nss-red);"><%= stats.totalRegistrations %></div>
        <div class="dash-stat-label">Total Registrations</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-emerald);"><%= stats.todayRegistrations %></div>
        <div class="dash-stat-label">Today's Registrations</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5M4.5 21V10.5M3 21h18" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-navy);"><%= stats.totalUnits %></div>
        <div class="dash-stat-label">Active NSS Units</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-nss-red);"><%= stats.totalLeadershipInterested || 0 %></div>
        <div class="dash-stat-label">Leadership Aspirants</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-gold);"><%= stats.totalMediaInterested %></div>
        <div class="dash-stat-label">Media Applicants</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-header">
          <div class="dash-stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
          </div>
        </div>
        <div class="dash-stat-number" style="color: var(--color-navy);"><%= stats.totalPreviousVolunteers %></div>
        <div class="dash-stat-label">Previous Volunteers</div>
      </div>
    </div>

    <!-- Graphical Charts Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <div class="dash-chart-card">
        <h3>NSS Unit-Wise Distribution</h3>
        <canvas id="unitChart" height="220"></canvas>
      </div>

      <div class="dash-chart-card">
        <h3>Gender Demographic</h3>
        <canvas id="genderChart" height="220"></canvas>
      </div>
    </div>

    <!-- Course & Year Distribution Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <div class="dash-chart-card">
        <h3>Top Course Registrations</h3>
        <canvas id="courseChart" height="220"></canvas>
      </div>

      <div class="dash-chart-card">
        <h3>Year of Study Distribution</h3>
        <canvas id="yearChart" height="220"></canvas>
      </div>
    </div>

    <!-- Recent Submissions Table -->
    <div class="dash-table-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px;">
        <h3 style="color: var(--color-navy); margin: 0; font-size: 1.2rem; font-weight: 800;">Recent Student Registrations</h3>
        <a href="/admin/registrations" style="font-size: 0.88rem; font-weight: 700; color: var(--color-nss-red); text-decoration: none;">View All Registrations →</a>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Registration ID</th>
              <th>Applicant Name</th>
              <th>Univ Reg No</th>
              <th>Unit</th>
              <th>Course</th>
              <th>Department</th>
              <th>Leadership?</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!recentRegistrations || recentRegistrations.length === 0) { %>
              <tr><td colspan="8" style="text-align:center; padding: 25px; color: var(--color-text-muted);">No volunteer registrations recorded yet.</td></tr>
            <% } else { %>
              <% recentRegistrations.forEach(function(reg) { %>
                <tr>
                  <td><strong style="color: var(--color-nss-red);"><%= reg.registration_id %></strong></td>
                  <td><strong><%= reg.applicant_name %></strong></td>
                  <td><%= reg.univ_reg_no %></td>
                  <td><span class="badge badge-submitted"><%= reg.unit_number %></span></td>
                  <td><%= reg.course %></td>
                  <td><%= reg.department %></td>
                  <td>
                    <span class="badge <%= reg.interested_in_leadership === 'Yes' ? 'badge-active' : 'badge-deleted' %>"><%= reg.interested_in_leadership || 'No' %></span>
                  </td>
                  <td>
                    <a href="/admin/registrations/<%= reg.id %>" class="btn btn-ghost" style="padding: 4px 10px; font-size: 0.8rem;">Profile</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Unit Distribution Chart
      const unitData = <%- JSON.stringify(chartData.unitCounts || []) %>;
      new Chart(document.getElementById('unitChart'), {
        type: 'bar',
        data: {
          labels: unitData.map(u => u.unit_number),
          datasets: [{
            label: 'Volunteers',
            data: unitData.map(u => u.count),
            backgroundColor: '#0F2042',
            borderRadius: 6
          }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
      });

      // Gender Pie Chart
      const genderData = <%- JSON.stringify(chartData.genderCounts || []) %>;
      new Chart(document.getElementById('genderChart'), {
        type: 'pie',
        data: {
          labels: genderData.map(g => g.gender),
          datasets: [{
            data: genderData.map(g => g.count),
            backgroundColor: ['#0F2042', '#D32F2F', '#16A34A', '#F59E0B']
          }]
        },
        options: { responsive: true }
      });

      // Top Courses Chart
      const courseData = <%- JSON.stringify(chartData.courseCounts || []) %>;
      new Chart(document.getElementById('courseChart'), {
        type: 'bar',
        data: {
          labels: courseData.map(c => c.course),
          datasets: [{
            label: 'Students',
            data: courseData.map(c => c.count),
            backgroundColor: '#D32F2F',
            borderRadius: 6
          }]
        },
        options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } } }
      });

      // Year of Study Doughnut Chart
      const yearData = <%- JSON.stringify(chartData.yearCounts || []) %>;
      new Chart(document.getElementById('yearChart'), {
        type: 'doughnut',
        data: {
          labels: yearData.map(y => y.year_of_study),
          datasets: [{
            data: yearData.map(y => y.count),
            backgroundColor: ['#16A34A', '#F59E0B', '#0F2042']
          }]
        },
      // Admin Profile Dropdown Toggle
      const profileBtn = document.getElementById('adminProfileBtn');
      const profileMenu = document.getElementById('adminProfileMenu');
      if (profileBtn && profileMenu) {
        profileBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          profileMenu.style.display = profileMenu.style.display === 'block' ? 'none' : 'block';
        });
        document.addEventListener('click', function() {
          profileMenu.style.display = 'none';
        });
      }
    });
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
