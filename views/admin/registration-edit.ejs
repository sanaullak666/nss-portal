<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="dashboard-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Floating Background Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <header class="site-header">
    <div class="header-inner container">
      <div class="logo-area">
        <div class="header-logo-group">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" class="logo-40yrs" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" class="logo-nss" title="National Service Scheme">
        </div>
        <div class="logo-text">
          Edit Volunteer Profile
          <small>Pondicherry University</small>
        </div>
      </div>
      <div class="header-actions" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
        <a href="/admin/registrations/<%= registration.id %>" class="btn btn-secondary btn-sm">← Back to Profile</a>
        <a href="/admin/logout" class="btn btn-logout btn-sm" style="font-weight: 700; border-radius: 8px;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" /></svg> Logout</a>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px; max-width: 900px;">
    <div class="dash-table-card" style="padding: clamp(14px, 4vw, 35px); box-sizing: border-box;">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--color-border); padding-bottom: 18px; margin-bottom: 25px; flex-wrap: wrap; gap: 12px;">
        <div>
          <h2 style="color: var(--color-navy); margin: 0; font-size: clamp(1.3rem, 3.5vw, 1.8rem); font-weight: 800; overflow-wrap: break-word;">Edit Student Registration Form</h2>
          <p style="color: var(--color-text-muted); margin: 4px 0 0 0; font-size: 0.95rem; overflow-wrap: anywhere; word-break: break-word;">
            Registration ID: <strong style="color: var(--color-nss-red); font-size: 1.05rem;"><%= registration.registration_id %></strong>
          </p>
        </div>
        <span class="badge badge-active" style="padding: 6px 16px; font-size: 0.85rem;">Edit Mode Active</span>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 14px 18px; border-radius: var(--radius-md); font-size: 0.9rem; margin-bottom: 25px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 10px;">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
          <div><strong>Validation Error:</strong> <%= error %></div>
        </div>
      <% } %>

      <form id="registrationForm" action="/admin/registrations/<%= registration.id %>/edit" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- SECTION 1: Personal Details -->
        <div class="section-header">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg></span> Personal Information
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="applicant_name">Full Name (As given in 10th certificate) <span class="required">*</span></label>
            <input type="text" id="applicant_name" name="applicant_name" class="form-control" placeholder="Enter full name" required value="<%= registration.applicant_name %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="univ_reg_no">University Register / Application No. <span class="required">*</span></label>
            <input type="text" id="univ_reg_no" name="univ_reg_no" class="form-control" placeholder="e.g. 25MCA00PY0085" required style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" value="<%= registration.univ_reg_no %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="email">Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" class="form-control" placeholder="student@pondiuni.ac.in" required value="<%= registration.email %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="contact_number">Contact Mobile Number (WhatsApp Enabled) <span class="required">*</span></label>
            <input type="tel" id="contact_number" name="contact_number" class="form-control" placeholder="10-digit mobile number" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" value="<%= registration.contact_number %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="alt_contact_number">Alternate Contact Number</label>
            <input type="tel" id="alt_contact_number" name="alt_contact_number" class="form-control" placeholder="10-digit mobile number (Optional)" inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" value="<%= registration.alt_contact_number || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="gender">Gender <span class="required">*</span></label>
            <select id="gender" name="gender" class="form-control" required>
              <option value="Male" <%= registration.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= registration.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Transgender" <%= registration.gender === 'Transgender' ? 'selected' : '' %>>Transgender</option>
              <option value="Prefer not to say" <%= registration.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
            </select>
          </div>
        </div>

        <div class="register-dob-grid">
          <div class="form-group">
            <label class="form-label" for="dob">Date of Birth <span class="required">*</span></label>
            <input type="date" id="dob" name="dob" class="form-control" required value="<%= registration.dob ? new Date(registration.dob).toISOString().split('T')[0] : '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="age">Age <span class="required">*</span></label>
            <input type="number" id="age" name="age" class="form-control" placeholder="Age" required min="15" max="60" value="<%= registration.age %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="blood_group">Blood Group <span class="required">*</span></label>
            <select id="blood_group" name="blood_group" class="form-control" required>
              <% if (constants && constants.BLOOD_GROUPS) { %>
                <% constants.BLOOD_GROUPS.forEach(function(bg) { %>
                  <option value="<%= bg %>" <%= registration.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="aadhaar_number">Aadhaar Number <span class="required">*</span></label>
            <input type="text" id="aadhaar_number" name="aadhaar_number" class="form-control" placeholder="12-digit Aadhaar Number" required inputmode="numeric" pattern="[0-9]{12}" maxlength="12" value="<%= registration.aadhaar_number %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="native_state">Native State / UT <span class="required">*</span></label>
            <select id="native_state" name="native_state" class="form-control" required>
              <% if (constants && constants.NATIVE_STATES) { %>
                <% constants.NATIVE_STATES.forEach(function(state) { %>
                  <option value="<%= state %>" <%= registration.native_state === state ? 'selected' : '' %>><%= state %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <!-- SECTION 2: Academic Details -->
        <div class="section-header">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147L12 14.6l7.74-4.453a1.5 1.5 0 000-2.594L12 3.1 4.26 7.553a1.5 1.5 0 000 2.594z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 12v4.5c0 1.25 2.686 2.25 6 2.25s6-1 6-2.25V12" /></svg></span> Academic Information & Unit Assignment
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="department">Department / Centre / School <span class="required">*</span></label>
            <select name="department" id="department" class="form-control" required>
              <% if (constants && constants.DEPARTMENT_UNIT_MAP) { %>
                <% Object.keys(constants.DEPARTMENT_UNIT_MAP).forEach(function(unitKey) { %>
                  <optgroup label="<%= unitKey %>">
                    <% constants.DEPARTMENT_UNIT_MAP[unitKey].forEach(function(dept) { %>
                      <option value="<%= dept %>" data-unit="<%= unitKey %>" <%= registration.department === dept ? 'selected' : '' %>><%= dept %></option>
                    <% }); %>
                  </optgroup>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="course">Course / Programme <span class="required">*</span></label>
            <select name="course" id="course" class="form-control" required>
              <% if (constants && constants.COURSES) { %>
                <% constants.COURSES.forEach(function(c) { %>
                  <option value="<%= c %>" <%= registration.course === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="year_of_study">Year of Study <span class="required">*</span></label>
            <select name="year_of_study" id="year_of_study" class="form-control" required>
              <% if (constants && constants.YEAR_OF_STUDY) { %>
                <% constants.YEAR_OF_STUDY.forEach(function(y) { %>
                  <option value="<%= y %>" <%= registration.year_of_study === y ? 'selected' : '' %>><%= y %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="unit_number_display">Mapped NSS Unit Number <span class="required">*</span></label>
            <input type="text" id="unit_number_display" class="form-control" value="<%= registration.unit_number %>" readonly style="background-color: #f1f5f9; cursor: not-allowed; font-weight: 700; color: var(--color-navy);">
            <input type="hidden" name="unit_number" id="unit_number" value="<%= registration.unit_number %>">
          </div>
        </div>

        <!-- SECTION 3: Address Details -->
        <div class="section-header">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg></span> Address Information
        </div>

        <div class="form-group">
          <label class="form-label" for="present_address">Present Address (Puducherry / Campus Hostel) <span class="required">*</span></label>
          <textarea id="present_address" name="present_address" class="form-control" rows="2" required><%= registration.present_address %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="permanent_address">Permanent Address <span class="required">*</span></label>
          <textarea id="permanent_address" name="permanent_address" class="form-control" rows="2" required><%= registration.permanent_address %></textarea>
        </div>

        <!-- SECTION 4: Language Proficiency -->
        <div class="section-header">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a.75.75 0 01-1.074-.85 5.977 5.977 0 011.603-2.55C4.053 16.035 3 14.12 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg></span> Language Proficiency
        </div>

        <div class="form-group">
          <label class="form-label">Select Languages Spoken & Written <span class="required">*</span></label>
          <div class="register-languages-grid">
            <% 
              let selectedLangs = [];
              if (registration.languages_spoken) {
                if (Array.isArray(registration.languages_spoken)) selectedLangs = registration.languages_spoken;
                else if (typeof registration.languages_spoken === 'string') {
                  try {
                    const parsed = JSON.parse(registration.languages_spoken);
                    selectedLangs = Array.isArray(parsed) ? parsed : registration.languages_spoken.split(',').map(s => s.trim());
                  } catch (e) {
                    selectedLangs = registration.languages_spoken.split(',').map(s => s.trim());
                  }
                }
              }
            %>
            <% if (constants && constants.INDIAN_LANGUAGES) { %>
              <% constants.INDIAN_LANGUAGES.forEach(function(lang) { %>
                <label class="custom-check">
                  <input type="checkbox" name="languages_spoken[]" value="<%= lang %>" <%= selectedLangs.includes(lang) ? 'checked' : '' %>>
                  <span><%= lang %></span>
                </label>
              <% }); %>
            <% } %>
          </div>
        </div>

        <!-- SECTION 5: NSS Experience, Media Roles & Leadership -->
        <div class="section-header">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg></span> NSS History, Media Roles & Leadership Interest
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="is_previous_volunteer">Have you been an NSS Volunteer previously? <span class="required">*</span></label>
            <select id="is_previous_volunteer" name="is_previous_volunteer" class="form-control" required>
              <option value="No" <%= registration.is_previous_volunteer === 'No' ? 'selected' : '' %>>No</option>
              <option value="Yes" <%= registration.is_previous_volunteer === 'Yes' ? 'selected' : '' %>>Yes</option>
            </select>
          </div>

          <% if (registration.certificate_path) { %>
            <div class="form-group">
              <label class="form-label">Uploaded Certificate Document</label>
              <div style="padding-top: 8px;">
                <a href="/uploads/<%= registration.certificate_path %>" target="_blank" class="btn btn-success btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32a1.5 1.5 0 01-2.121-2.121l9.9-9.9" /></svg> View Uploaded Certificate
                </a>
              </div>
            </div>
          <% } %>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="interested_in_media">Interested in Media / PR / Documentation Team? <span class="required">*</span></label>
            <select id="interested_in_media" name="interested_in_media" class="form-control" required>
              <option value="No" <%= registration.interested_in_media === 'No' ? 'selected' : '' %>>No</option>
              <option value="Yes" <%= registration.interested_in_media === 'Yes' ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
        </div>

        <div class="form-group" id="media_roles_group" style="<%= registration.interested_in_media === 'Yes' ? 'display: block;' : 'display: none;' %>">
          <label class="form-label">Select Preferred Media / Creative Roles:</label>
          <div class="register-media-grid">
            <% 
              let selectedRoles = [];
              if (registration.media_roles) {
                if (Array.isArray(registration.media_roles)) selectedRoles = registration.media_roles;
                else if (typeof registration.media_roles === 'string') {
                  try {
                    const parsed = JSON.parse(registration.media_roles);
                    selectedRoles = Array.isArray(parsed) ? parsed : registration.media_roles.split(',').map(s => s.trim());
                  } catch (e) {
                    selectedRoles = registration.media_roles.split(',').map(s => s.trim());
                  }
                }
              }
            %>
            <% if (constants && constants.MEDIA_ROLES) { %>
              <% constants.MEDIA_ROLES.forEach(function(role) { %>
                <label class="custom-check">
                  <input type="checkbox" name="media_roles[]" value="<%= role %>" <%= selectedRoles.includes(role) ? 'checked' : '' %>>
                  <span><%= role %></span>
                </label>
              <% }); %>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="extra_curricular_skills">Extra Curricular Skills (Mention if any)</label>
          <textarea id="extra_curricular_skills" name="extra_curricular_skills" class="form-control" rows="2" placeholder="e.g. Sports, Music, Dance, Public Speaking, Fine Arts"><%= registration.extra_curricular_skills || '' %></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 25px;">
          <label class="form-label" for="interested_in_leadership">Are you interested in being a leader in NSS PU? <span class="required">*</span></label>
          <select id="interested_in_leadership" name="interested_in_leadership" class="form-control" required>
            <option value="No" <%= registration.interested_in_leadership === 'No' ? 'selected' : '' %>>No</option>
            <option value="Yes" <%= registration.interested_in_leadership === 'Yes' ? 'selected' : '' %>>Yes</option>
          </select>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap;">
          <button type="submit" id="submitBtn" class="btn btn-primary" style="flex: 2 1 200px; padding: 14px; font-size: 1.05rem; justify-content: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3h12l4.5 4.5V20.25A1.75 1.75 0 0119.25 22H4.75A1.75 1.75 0 013 20.25V4.75A1.75 1.75 0 014.5 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 3v5h9V3M7 21v-7h10v7" /></svg> Save & Update Volunteer Profile
          </button>
          <a href="/admin/registrations/<%= registration.id %>" class="btn btn-secondary" style="flex: 1 1 100px; justify-content: center;">
            Cancel
          </a>
        </div>
      </form>

    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
