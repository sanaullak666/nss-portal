<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="login-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('../partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: clamp(20px, 4vw, 40px) clamp(10px, 2vw, 20px);">
    <div class="login-wrapper">
      <div class="login-card">
        
        <div class="login-brand">
          <div class="login-logo-group">
            <img src="/images/pondilogo.png" alt="Pondicherry University Logo">
            <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" class="logo-40yrs">
            <img src="/images/nsslogo.jpg" alt="NSS Logo" class="logo-nss">
          </div>
          <h1>Reset Admin Password</h1>
          <span class="subtitle">Email OTP Verification • PU NSS Portal</span>
        </div>

        <% if (locals.error && error) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 8px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (locals.success && success) { %>
          <div class="alert alert-success" style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid #16a34a; display: flex; align-items: center; gap: 8px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span>
            <div><%= success %></div>
          </div>
        <% } %>

        <form action="/admin/send-otp" method="POST" class="login-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="form-group">
            <label for="email">Admin Email Address</label>
            <div class="input-container">
              <input type="email" id="email" name="email" class="form-control-custom" value="<%= defaultEmail %>" required autofocus placeholder="Enter registered admin email">
              <span class="input-icon">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
            </div>
            <small style="color: var(--color-text-muted); display: block; margin-top: 6px; font-size: 0.8rem;">
              A 6-digit One-Time Password (OTP) will be sent to this email address.
            </small>
          </div>

          <button type="submit" class="login-btn" style="background: linear-gradient(135deg, var(--color-nss-red), #880e4f); border: none;">
            <span class="btn-text">Send OTP via Email</span>
            <span class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px;"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg></span>
          </button>
        </form>

        <div class="login-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <a href="/admin/login" style="display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
            <span>Back to Admin Login</span>
          </a>
          <a href="/admin/verify-otp" style="display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
            <span>Already have OTP? Verify</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
