<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       OFFICIAL PRINT STYLESHEET FOR VOLUNTEER PROFILE
       ============================================================ */
    @media print {
      /* Hide all non-essential web UI elements */
      .no-print,
      .site-header,
      .site-footer,
      .particles,
      .loader-overlay,
      #globalLoaderOverlay {
        display: none !important;
      }

      /* Page margins and setup */
      @page {
        size: A4 portrait;
        margin: 12mm 15mm 12mm 15mm;
      }

      html, body {
        background: #ffffff !important;
        color: #0f172a !important;
        font-family: 'Inter', -apple-system, sans-serif !important;
        font-size: 10pt !important;
        line-height: 1.4 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        min-height: auto !important;
        height: auto !important;
        overflow: visible !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      main.container {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .dash-table-card {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        background: #ffffff !important;
      }

      /* Show Official Print Header */
      .print-header {
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        border-bottom: 2.5px solid #0f2042;
        padding-bottom: 12px;
        margin-bottom: 18px;
      }

      .print-header img {
        height: 48px;
        width: auto;
        object-fit: contain;
      }

      .print-header-title {
        text-align: center;
        flex: 1;
      }

      .print-header-title h2 {
        margin: 0;
        font-size: 14pt;
        font-weight: 800;
        color: #0f2042;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .print-header-title h4 {
        margin: 2px 0 0 0;
        font-size: 10pt;
        font-weight: 700;
        color: #d32f2f;
        letter-spacing: 0.3px;
      }

      /* Clean Data Boxes for Printing */
      .profile-info-box {
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 12px 14px !important;
        margin-bottom: 18px !important;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      h3.section-title {
        font-size: 11pt !important;
        font-weight: 800 !important;
        color: #0f2042 !important;
        margin-bottom: 8px !important;
        margin-top: 14px !important;
        border-left-width: 4px !important;
        padding-left: 8px !important;
        page-break-after: avoid;
        break-after: avoid;
      }

      .badge {
        border: 1px solid #64748b !important;
        color: #0f172a !important;
        background: #f1f5f9 !important;
        padding: 2px 8px !important;
        font-size: 8.5pt !important;
      }

      /* Official Verification Signature Block */
      .print-footer-signature {
        display: block !important;
        margin-top: 40px;
        padding-top: 15px;
        page-break-inside: avoid;
        break-inside: avoid;
      }
    }
  </style>
</head>
<body class="dashboard-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Floating Particles -->
  <div class="particles no-print" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <header class="site-header no-print">
    <div class="header-inner container">
      <div class="logo-area">
        <div class="header-logo-group">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" class="logo-40yrs" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" class="logo-nss" title="National Service Scheme">
        </div>
        <div class="logo-text">
          Volunteer Profile
          <small>Pondicherry University</small>
        </div>
      </div>
      <div class="header-actions" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
        <a href="/admin/registrations" class="btn btn-secondary btn-sm">← Back to List</a>
        <a href="/admin/logout" class="btn btn-logout btn-sm" style="font-weight: 700; border-radius: 8px;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" /></svg> Logout</a>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px; max-width: 900px;">
    <div class="dash-table-card" style="padding: clamp(14px, 4vw, 35px); box-sizing: border-box;">
      
      <!-- Official Header (Only Visible When Printing) -->
      <div class="print-header" style="display: none;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo">
          <img src="/images/nsslogo.jpg" alt="NSS Logo">
        </div>
        <div class="print-header-title">
          <h2>Pondicherry University</h2>
          <h4>NATIONAL SERVICE SCHEME (NSS) WING</h4>
          <p style="margin: 2px 0 0 0; font-size: 8.5pt; font-weight: 600; color: #475569;">OFFICIAL VOLUNTEER REGISTRATION RECORD 2026</p>
        </div>
        <div style="text-align: right; font-size: 8.5pt; color: #334155;">
          <strong>Date Printed:</strong><br><%= new Date().toLocaleDateString('en-IN') %>
        </div>
      </div>

      <!-- Top Action Bar -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--color-border); padding-bottom: 18px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div style="min-width: 0; flex: 1;">
          <h1 style="margin: 0; color: var(--color-navy); font-size: clamp(1.3rem, 3.5vw, 1.8rem); font-weight: 800; overflow-wrap: break-word;"><%= registration.applicant_name %></h1>
          <p style="margin: 6px 0 0; color: var(--color-text-muted); font-size: 0.95rem; overflow-wrap: anywhere; word-break: break-word;">
            Registration ID: <strong style="color: var(--color-nss-red); font-size: 1.05rem;"><%= registration.registration_id %></strong> | 
            Assigned Unit: <span class="badge badge-submitted"><%= registration.unit_number %></span>
          </p>
        </div>

        <div class="no-print" style="display: flex; gap: 8px; flex-wrap: wrap; width: auto;">
          <a href="/admin/registrations/<%= registration.id %>/pdf?inline=1" target="_blank" class="btn btn-secondary btn-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m11.318-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.656" /></svg> Print Profile</a>
          <a href="/admin/registrations/<%= registration.id %>/pdf" class="btn btn-primary btn-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg> PDF Slip</a>
          <a href="/admin/registrations/<%= registration.id %>/edit" class="btn btn-outline btn-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg> Edit</a>
          
          <!-- Delete Action -->
          <form action="/admin/registrations/<%= registration.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this volunteer registration?');" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg> Delete</button>
          </form>
        </div>
      </div>

      <!-- Academic Info Section -->
      <h3 class="section-title" style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-navy); padding-left: 10px;">Academic Details</h3>
      <div class="profile-info-box" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: clamp(12px, 3vw, 18px); border-radius: var(--radius-md); border: 1px solid var(--color-border); overflow-wrap: anywhere; word-break: break-word;">
        <div><strong>Univ Reg No:</strong> <%= registration.univ_reg_no %></div>
        <div><strong>Department:</strong> <%= registration.department %></div>
        <div><strong>Course:</strong> <%= registration.course %></div>
        <div><strong>Year of Study:</strong> <%= registration.year_of_study %></div>
        <div><strong>NSS Unit:</strong> <%= registration.unit_number %></div>
        <div><strong>Submitted Date:</strong> <%= new Date(registration.created_at).toLocaleString('en-IN') %></div>
      </div>

      <!-- Personal Info Section -->
      <h3 class="section-title" style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-nss-red); padding-left: 10px;">Personal Details</h3>
      <div class="profile-info-box" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: clamp(12px, 3vw, 18px); border-radius: var(--radius-md); border: 1px solid var(--color-border); overflow-wrap: anywhere; word-break: break-word;">
        <div><strong>Email Address:</strong> <%= registration.email %></div>
        <div><strong>Contact Mobile:</strong> <%= registration.contact_number %></div>
        <div><strong>Alternate Mobile:</strong> <%= registration.alt_contact_number || 'N/A' %></div>
        <div><strong>Gender:</strong> <%= registration.gender %></div>
        <div><strong>Date of Birth:</strong> <%= new Date(registration.dob).toISOString().split('T')[0] %></div>
        <div><strong>Age:</strong> <%= registration.age %> Years</div>
        <div><strong>Blood Group:</strong> <%= registration.blood_group %></div>
        <div><strong>Aadhaar Number:</strong> <%= registration.aadhaar_number %></div>
        <div><strong>Native State:</strong> <%= registration.native_state %></div>
      </div>

      <!-- Address Info Section -->
      <h3 class="section-title" style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-emerald); padding-left: 10px;">Address Details</h3>
      <div class="profile-info-box" style="margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: clamp(12px, 3vw, 18px); border-radius: var(--radius-md); border: 1px solid var(--color-border); overflow-wrap: anywhere; word-break: break-word;">
        <p style="margin-bottom: 10px;"><strong>Present Address:</strong> <%= registration.present_address %></p>
        <p style="margin: 0;"><strong>Permanent Address:</strong> <%= registration.permanent_address %></p>
      </div>

      <!-- Languages & NSS Skills Section -->
      <h3 class="section-title" style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-gold); padding-left: 10px;">Languages, Skills & Leadership</h3>
      <div class="profile-info-box" style="background: rgba(248, 250, 252, 0.9); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <% 
          let languages = registration.languages_spoken;
          if (typeof languages === 'string') {
            try {
              const parsed = JSON.parse(languages);
              if (Array.isArray(parsed)) languages = parsed.join(', ');
            } catch (e) {}
          } else if (Array.isArray(languages)) {
            languages = languages.join(', ');
          }

          let roles = registration.media_roles;
          if (typeof roles === 'string') {
            try {
              const parsed = JSON.parse(roles);
              if (Array.isArray(parsed)) roles = parsed.join(', ');
            } catch (e) {}
          } else if (Array.isArray(roles)) {
            roles = roles.join(', ');
          }
        %>
        <p style="margin-bottom: 10px;"><strong>Languages Spoken:</strong> <%= languages || 'N/A' %></p>
        <p style="margin-bottom: 10px;"><strong>Previous NSS Volunteer:</strong> <%= registration.is_previous_volunteer %></p>
        
        <% if (registration.certificate_path) { %>
          <p style="margin-bottom: 10px;">
            <strong>Uploaded Certificate:</strong> 
            <a href="/uploads/<%= registration.certificate_path %>" target="_blank" class="btn btn-success btn-sm" style="margin-left: 8px;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32a1.5 1.5 0 01-2.121-2.121l9.9-9.9" /></svg> Open Certificate / Document</a>
          </p>
        <% } %>

        <p style="margin-bottom: 10px;"><strong>Media Team Interest:</strong> <%= registration.interested_in_media || 'No' %></p>
        <p style="margin-bottom: 10px;"><strong>Selected Media Roles:</strong> <%= roles || 'N/A' %></p>
        <p style="margin-bottom: 10px;"><strong>Extra Curricular Skills:</strong> <%= registration.extra_curricular_skills || 'None' %></p>
        <p style="margin: 0;"><strong>Interested in NSS PU Leadership:</strong> <span class="badge <%= registration.interested_in_leadership === 'Yes' ? 'badge-active' : 'badge-deleted' %>"><%= registration.interested_in_leadership || 'No' %></span></p>
      </div>

      <!-- Official Signature & Verification Block (Only Visible When Printing) -->
      <div class="print-footer-signature" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 35px; padding-top: 10px;">
          <div style="text-align: center; width: 200px;">
            <div style="border-bottom: 1px solid #0f172a; height: 35px;"></div>
            <p style="margin: 5px 0 0 0; font-weight: 700; font-size: 8.5pt; color: #0f172a;">Volunteer Signature</p>
          </div>
          <div style="text-align: center; width: 220px;">
            <div style="border-bottom: 1px solid #0f172a; height: 35px;"></div>
            <p style="margin: 5px 0 0 0; font-weight: 700; font-size: 8.5pt; color: #0f172a;">Program Officer Signature & Seal</p>
          </div>
        </div>
        <p style="margin-top: 25px; margin-bottom: 0; text-align: center; font-size: 8pt; color: #64748b;">
          Official Document • Pondicherry University National Service Scheme (NSS) Portal
        </p>
      </div>

    </div>
  </main>

  <div class="no-print">
    <%- include('../partials/footer') %>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
