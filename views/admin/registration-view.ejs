<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white; }
      .dash-table-card { box-shadow: none; border: none; }
    }
  </style>
</head>
<body class="dashboard-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <%- include('../partials/loader') %>

  <!-- Floating Particles -->
  <div class="particles no-print" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <header class="site-header no-print">
    <div class="header-inner container">
      <div class="logo-area" style="display: flex; align-items: center; gap: 12px;">
        <div class="header-logo-group" style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.9); padding: 4px 8px; border-radius: 8px; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 40px; width: auto; object-fit: contain;" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 4px;" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 50%;" title="National Service Scheme">
        </div>
        <div class="logo-text">
          Volunteer Profile
          <small style="display: block;">Pondicherry University</small>
        </div>
      </div>
      <div>
        <a href="/admin/registrations" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem;">← Back to List</a>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px; max-width: 900px;">
    <div class="dash-table-card" style="padding: 35px;">
      
      <!-- Top Action Bar -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--color-border); padding-bottom: 18px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div>
          <h1 style="margin: 0; color: var(--color-navy); font-size: 1.8rem; font-weight: 800;"><%= registration.applicant_name %></h1>
          <p style="margin: 6px 0 0; color: var(--color-text-muted); font-size: 0.95rem;">
            Registration ID: <strong style="color: var(--color-nss-red); font-size: 1.1rem;"><%= registration.registration_id %></strong> | 
            Assigned Unit: <span class="badge badge-submitted"><%= registration.unit_number %></span>
          </p>
        </div>

        <div class="no-print" style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button onclick="window.print()" class="btn btn-secondary" style="font-size: 0.85rem;">🖨️ Print Profile</button>
          <a href="/admin/registrations/<%= registration.id %>/pdf" class="btn btn-primary" style="font-size: 0.85rem;">📄 PDF Slip</a>
          <a href="/admin/registrations/<%= registration.id %>/edit" class="btn btn-outline" style="font-size: 0.85rem;">✏️ Edit</a>
          
          <!-- Delete Action -->
          <form action="/admin/registrations/<%= registration.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this volunteer registration?');" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn" style="background: #fee2e2; color: #b71c1c; font-size: 0.85rem; padding: 6px 14px;">🗑️ Delete</button>
          </form>
        </div>
      </div>

      <!-- Academic Info Section -->
      <h3 style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-navy); padding-left: 10px;">Academic Details</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <div><strong>Univ Reg No:</strong> <%= registration.univ_reg_no %></div>
        <div><strong>Department:</strong> <%= registration.department %></div>
        <div><strong>Course:</strong> <%= registration.course %></div>
        <div><strong>Year of Study:</strong> <%= registration.year_of_study %></div>
        <div><strong>NSS Unit:</strong> <%= registration.unit_number %></div>
        <div><strong>Submitted Date:</strong> <%= new Date(registration.created_at).toLocaleString('en-IN') %></div>
      </div>

      <!-- Personal Info Section -->
      <h3 style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-nss-red); padding-left: 10px;">Personal Details</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <div><strong>Email Address:</strong> <%= registration.email %></div>
        <div><strong>Contact Mobile:</strong> <%= registration.contact_number %></div>
        <div><strong>Alternate Mobile:</strong> <%= registration.alt_contact_number || 'N/A' %></div>
        <div><strong>Gender:</strong> <%= registration.gender %></div>
        <div><strong>Date of Birth:</strong> <%= new Date(registration.dob).toISOString().split('T')[0] %></div>
        <div><strong>Age:</strong> <%= registration.age %> Years</div>
        <div><strong>Blood Group:</strong> <%= registration.blood_group %></div>
        <div><strong>Aadhaar Number:</strong> <%= registration.aadhaar_number %></div>
        <div><strong>Native State:</strong> <%= registration.native_state %></div>
      </div>

      <!-- Address Info Section -->
      <h3 style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-emerald); padding-left: 10px;">Address Details</h3>
      <div style="margin-bottom: 25px; background: rgba(248, 250, 252, 0.9); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <p style="margin-bottom: 10px;"><strong>Present Address:</strong> <%= registration.present_address %></p>
        <p style="margin: 0;"><strong>Permanent Address:</strong> <%= registration.permanent_address %></p>
      </div>

      <!-- Languages & NSS Skills Section -->
      <h3 style="color: var(--color-navy); font-size: 1.15rem; font-weight: 800; margin-bottom: 15px; border-left: 4px solid var(--color-gold); padding-left: 10px;">Languages, Skills & Leadership</h3>
      <div style="background: rgba(248, 250, 252, 0.9); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <% 
          let languages = registration.languages_spoken;
          if (typeof languages === 'string') {
            try {
              const parsed = JSON.parse(languages);
              if (Array.isArray(parsed)) languages = parsed.join(', ');
            } catch (e) {}
          } else if (Array.isArray(languages)) {
            languages = languages.join(', ');
          }

          let roles = registration.media_roles;
          if (typeof roles === 'string') {
            try {
              const parsed = JSON.parse(roles);
              if (Array.isArray(parsed)) roles = parsed.join(', ');
            } catch (e) {}
          } else if (Array.isArray(roles)) {
            roles = roles.join(', ');
          }
        %>
        <p style="margin-bottom: 10px;"><strong>Languages Spoken:</strong> <%= languages || 'N/A' %></p>
        <p style="margin-bottom: 10px;"><strong>Previous NSS Volunteer:</strong> <%= registration.is_previous_volunteer %></p>
        
        <% if (registration.certificate_path) { %>
          <p style="margin-bottom: 10px;">
            <strong>Uploaded Certificate:</strong> 
            <a href="/uploads/<%= registration.certificate_path %>" target="_blank" class="btn btn-success btn-sm" style="margin-left: 8px;">📎 Open Certificate / Document</a>
          </p>
        <% } %>

        <p style="margin-bottom: 10px;"><strong>Media Team Interest:</strong> <%= registration.interested_in_media || 'No' %></p>
        <p style="margin-bottom: 10px;"><strong>Selected Media Roles:</strong> <%= roles || 'N/A' %></p>
        <p style="margin-bottom: 10px;"><strong>Extra Curricular Skills:</strong> <%= registration.extra_curricular_skills || 'None' %></p>
        <p style="margin: 0;"><strong>Interested in NSS PU Leadership:</strong> <span class="badge <%= registration.interested_in_leadership === 'Yes' ? 'badge-active' : 'badge-deleted' %>"><%= registration.interested_in_leadership || 'No' %></span></p>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
