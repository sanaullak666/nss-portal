<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="login-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('../partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="login-wrapper">
      <div class="login-card">
        
        <div class="login-brand">
          <div class="login-logo-group">
            <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 48px; width: auto; object-fit: contain;">
            <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 48px; width: auto; object-fit: contain; border-radius: 50%;">
          </div>
          <h1>Verify OTP & New Password</h1>
          <span class="subtitle">Enter the 6-Digit Code Sent to Email</span>
        </div>

        <% if (locals.error && error) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 8px;">
            <span>⚠️</span>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (locals.success && success) { %>
          <div class="alert alert-success" style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid #16a34a; display: flex; align-items: center; gap: 8px;">
            <span>📩</span>
            <div><%= success %></div>
          </div>
        <% } %>

        <form action="/admin/verify-otp" method="POST" class="login-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="email" value="<%= email %>">
          
          <div class="form-group">
            <label for="otp_code">6-Digit Verification OTP</label>
            <div class="input-container">
              <input type="text" id="otp_code" name="otp_code" class="form-control-custom" placeholder="e.g. 849201" value="<%= otpCode %>" maxlength="6" pattern="[0-9]{6}" required autofocus style="letter-spacing: 4px; font-weight: 700; font-size: 1.1rem; text-align: center;">
              <span class="input-icon">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
            </div>
            <small style="color: var(--color-text-muted); display: block; margin-top: 4px; font-size: 0.8rem;">
              Target Email: <strong><%= email %></strong>
            </small>
          </div>

          <div class="form-group">
            <label for="new_password">New Admin Password</label>
            <div class="input-container">
              <input type="password" id="new_password" name="new_password" class="form-control-custom" placeholder="Enter new password (min. 6 chars)" required minlength="6">
              <span class="input-icon">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/>
                </svg>
              </span>
            </div>
          </div>

          <div class="form-group">
            <label for="confirm_password">Confirm New Password</label>
            <div class="input-container">
              <input type="password" id="confirm_password" name="confirm_password" class="form-control-custom" placeholder="Re-enter new password" required minlength="6">
              <span class="input-icon">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/>
                </svg>
              </span>
            </div>
          </div>

          <button type="submit" class="login-btn" style="background: linear-gradient(135deg, #16a34a, #15803d); border: none;">
            <span class="btn-text">Update Admin Password</span>
            <span class="btn-icon">🔒</span>
          </button>
        </form>

        <div class="login-footer" style="display: flex; justify-content: space-between; align-items: center;">
          <a href="/admin/forgot-password">Resend OTP / Change Email</a>
          <a href="/admin/login">← Back to Login</a>
        </div>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
