<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="login-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('../partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="login-wrapper">
      <div class="login-card">
        
        <div class="login-brand">
          <div class="login-logo-group">
            <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 48px; width: auto; object-fit: contain;">
            <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 48px; width: auto; object-fit: contain; border-radius: 50%;">
          </div>
          <h1>2FA Security Verification</h1>
          <span class="subtitle">Two-Factor Authentication for Admin Access</span>
          <div class="motto">"Not Me But You"</div>
        </div>

        <% if (locals.error && error) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 8px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (locals.success && success) { %>
          <div class="alert alert-success" style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.88rem; margin-bottom: 22px; border-left: 4px solid #16a34a; display: flex; align-items: center; gap: 8px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg></span>
            <div><%= success %></div>
          </div>
        <% } %>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 14px 16px; margin-bottom: 24px; text-align: center;">
          <div style="font-size: 0.88rem; color: #475569; font-weight: 500;">A 6-digit login security OTP has been sent to your registered admin email.</div>
          <div style="font-size: 0.78rem; color: #64748b; margin-top: 4px;">(OTP code valid for 10 minutes)</div>
        </div>

        <form action="/admin/verify-login-otp" method="POST" class="login-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="form-group">
            <label for="otp_code">Enter 6-Digit Security OTP</label>
            <div class="input-container">
              <input type="text" id="otp_code" name="otp_code" class="form-control-custom" placeholder="------" maxlength="6" pattern="[0-9]{6}" required autofocus autocomplete="one-time-code" style="letter-spacing: 8px; font-weight: 800; font-size: 1.3rem; text-align: center;">
              <span class="input-icon">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
            </div>
          </div>

          <button type="submit" class="login-btn" id="verifyOtpBtn">
            <span class="btn-text">Verify & Complete Sign In</span>
            <span class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="display:inline-block; vertical-align:-2px;"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></span>
          </button>
        </form>

        <form action="/admin/resend-login-otp" method="POST" style="margin-top: 14px; text-align: center;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" style="background: transparent; border: none; color: var(--color-nss-navy); font-weight: 600; font-size: 0.85rem; cursor: pointer; text-decoration: underline; display: inline-flex; align-items: center; gap: 6px; justify-content: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            <span>Didn't receive code? Resend Login OTP</span>
          </button>
        </form>

        <div class="login-footer" style="margin-top: 20px; display: flex; justify-content: center;">
          <a href="/admin/login" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Cancel & Back to Login</span>
          </a>
        </div>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
