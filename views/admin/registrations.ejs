<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    .filter-bar-custom {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      padding: 20px;
      border-radius: var(--radius-xl);
      margin-bottom: 24px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      box-shadow: var(--shadow-md);
    }
    .filter-bar-custom input, .filter-bar-custom select {
      padding: 10px 14px;
      border: 2px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      background: var(--color-surface);
      color: var(--color-navy);
      outline: none;
      transition: border-color var(--transition-fast);
    }
    .filter-bar-custom input:focus, .filter-bar-custom select:focus {
      border-color: var(--color-nss-red);
    }
    .btn-sm {
      padding: 6px 14px;
      font-size: 0.84rem;
      border-radius: var(--radius-md);
      min-height: 36px;
    }
    .pagination-custom {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-top: 24px;
      flex-wrap: wrap;
    }
    .pagination-custom a, .pagination-custom span {
      padding: 8px 16px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      color: var(--color-navy);
      background: var(--color-surface);
      transition: all var(--transition-fast);
    }
    .pagination-custom a:hover {
      border-color: var(--color-nss-red);
      color: var(--color-nss-red);
    }
    .pagination-custom .active {
      background: var(--color-nss-red);
      color: white;
      border-color: var(--color-nss-red);
    }
  </style>
</head>
<body class="dashboard-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <%- include('../partials/loader') %>

  <!-- Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <header class="site-header">
    <div class="header-inner container">
      <div class="logo-area" style="display: flex; align-items: center; gap: 12px;">
        <div class="header-logo-group" style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.9); padding: 4px 8px; border-radius: 8px; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 40px; width: auto; object-fit: contain;" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 4px;" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 40px; width: auto; object-fit: contain; border-radius: 50%;" title="National Service Scheme">
        </div>
        <div class="logo-text">
          Student Registrations
          <small style="display: block;">Pondicherry University</small>
        </div>
      </div>
      <div>
        <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="margin-right: 8px;">← Dashboard</a>
        <a href="/admin/registrations/export/excel" class="btn btn-primary btn-sm" style="margin-right: 8px;"><svg style="display:inline-block; vertical-align:-2px; margin-right:4px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg> Export Excel</a>
        <a href="/admin/logout" class="btn btn-logout btn-sm" style="padding: 6px 16px; font-size: 0.88rem; font-weight: 700; border-radius: 8px;"><svg style="display:inline-block; vertical-align:-2px; margin-right:4px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25"/></svg> Logout</a>
      </div>
    </div>
  </header>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px;">
    
    <!-- Search & Filter Form -->
    <form method="GET" action="/admin/registrations" class="filter-bar-custom">
      <input type="text" name="search" placeholder="Search Name, Reg ID, Mobile, Aadhaar, Dept..." value="<%= filters.search %>" style="flex: 2; min-width: 240px;">
      
      <!-- Filter by Unit -->
      <select name="unit">
        <option value="">All NSS Units</option>
        <% UNITS.forEach(function(u) { %>
          <option value="<%= u %>" <%= filters.unit === u ? 'selected' : '' %>><%= u %></option>
        <% }); %>
      </select>

      <!-- Filter by Course -->
      <select name="course">
        <option value="">All Courses</option>
        <% COURSES.forEach(function(c) { %>
          <option value="<%= c %>" <%= filters.course === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>

      <!-- Filter by Year of Study -->
      <select name="year_of_study">
        <option value="">All Years</option>
        <% YEAR_OF_STUDY.forEach(function(y) { %>
          <option value="<%= y %>" <%= filters.year_of_study === y ? 'selected' : '' %>><%= y %></option>
        <% }); %>
      </select>

      <!-- Filter by Previous Volunteer Status -->
      <select name="is_previous_volunteer">
        <option value="">Prev Volunteer?</option>
        <option value="Yes" <%= filters.is_previous_volunteer === 'Yes' ? 'selected' : '' %>>Yes</option>
        <option value="No" <%= filters.is_previous_volunteer === 'No' ? 'selected' : '' %>>No</option>
      </select>

      <!-- Filter by Media Team Interest -->
      <select name="interested_in_media">
        <option value="">Media Interest?</option>
        <option value="Yes" <%= filters.interested_in_media === 'Yes' ? 'selected' : '' %>>Yes</option>
        <option value="No" <%= filters.interested_in_media === 'No' ? 'selected' : '' %>>No</option>
      </select>

      <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
      <a href="/admin/registrations" class="btn btn-ghost btn-sm">Reset</a>
    </form>

    <!-- Table Card -->
    <div class="dash-table-card" style="padding: 0; overflow: hidden;">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Reg ID</th>
              <th>Applicant Name</th>
              <th>Univ Reg No</th>
              <th>Course</th>
              <th>Unit</th>
              <th>Mobile</th>
              <th>Certificate</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!registrations || registrations.length === 0) { %>
              <tr><td colspan="8" style="text-align:center; padding: 35px; color: var(--color-text-muted);">No student registrations found matching your query criteria.</td></tr>
            <% } else { %>
              <% registrations.forEach(function(reg) { %>
                <tr>
                  <td><strong style="color: var(--color-nss-red);"><%= reg.registration_id %></strong></td>
                  <td><strong><%= reg.applicant_name %></strong></td>
                  <td><%= reg.univ_reg_no %></td>
                  <td><%= reg.course %></td>
                  <td><span class="badge badge-submitted"><%= reg.unit_number %></span></td>
                  <td><%= reg.contact_number %></td>
                  <td>
                    <% if (reg.certificate_path) { %>
                      <a href="/uploads/<%= reg.certificate_path %>" target="_blank" class="btn btn-success btn-sm" style="padding: 3px 10px; font-size: 0.78rem;">View Cert</a>
                    <% } else { %>
                      <span style="color: var(--color-text-muted); font-size: 0.8rem;">None</span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display: flex; gap: 6px; align-items: center;">
                      <a href="/admin/registrations/<%= reg.id %>" class="btn btn-secondary btn-sm" title="View Profile">Profile</a>
                      <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-outline btn-sm" title="Edit Registration">Edit</a>
                      <a href="/admin/registrations/<%= reg.id %>/pdf" class="btn btn-primary btn-sm" title="Download PDF Slip">PDF</a>
                      
                      <!-- Delete Form with CSRF Token -->
                      <form action="/admin/registrations/<%= reg.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete registration <%= reg.registration_id %> (<%= reg.applicant_name %>)?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm" style="background: #fee2e2; color: #b71c1c; padding: 5px 10px; display: inline-flex; align-items: center; justify-content: center;" title="Delete Registration">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination Bar -->
    <% if (pagination.totalPages > 1) { %>
      <div class="pagination-custom">
        <% if (pagination.currentPage > 1) { %>
          <a href="/admin/registrations?page=<%= pagination.currentPage - 1 %>&unit=<%= filters.unit %>&course=<%= filters.course %>&year_of_study=<%= filters.year_of_study %>&search=<%= filters.search %>">« Prev</a>
        <% } %>

        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
          <a href="/admin/registrations?page=<%= i %>&unit=<%= filters.unit %>&course=<%= filters.course %>&year_of_study=<%= filters.year_of_study %>&search=<%= filters.search %>" class="<%= pagination.currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="/admin/registrations?page=<%= pagination.currentPage + 1 %>&unit=<%= filters.unit %>&course=<%= filters.course %>&year_of_study=<%= filters.year_of_study %>&search=<%= filters.search %>">Next »</a>
        <% } %>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
