<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="header-logo">
        <div>NATIONAL SERVICE SCHEME (NSS)</div>
      </div>
      <a href="/" class="btn btn-primary" style="padding: 6px 18px; font-size: 0.85rem;">Back to Home</a>
    </div>
  </header>

  <main class="container" style="padding-top: 60px; padding-bottom: 60px; max-width: 650px;">
    <div class="card" style="text-align: center; padding: 40px 30px;">
      
      <div style="font-size: 3rem; margin-bottom: 10px;">🎉</div>
      <h2 style="color: var(--nss-navy); margin-bottom: 5px;">Registration Successful</h2>
      <p style="color: var(--gray-600); font-size: 1.1rem; margin-bottom: 25px;">Thank you for registering with the Pondicherry University NSS Wing!</p>

      <div style="background: var(--gray-100); border: 2px dashed var(--nss-navy); padding: 20px; border-radius: var(--radius-lg); margin-bottom: 25px;">
        <span style="font-size: 0.85rem; color: var(--gray-600); font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Your Official Registration ID</span>
        <div style="font-size: 2rem; font-weight: 800; color: var(--nss-red); letter-spacing: 1px; margin-top: 5px;">
          <%= registration.registration_id %>
        </div>
      </div>

      <div class="alert alert-info" style="text-align: left; font-size: 0.95rem; line-height: 1.6; margin-bottom: 30px;">
        📌 <strong>Important Instruction:</strong> Please keep this Registration ID saved for future reference, certificate issuance, and NSS Unit communication.
      </div>

      <!-- Join WhatsApp Group Button Placeholder -->
      <a href="https://chat.whatsapp.com/EXAMPLE_NSS_GROUP_LINK" target="_blank" rel="noopener noreferrer" class="btn" style="background: #25D366; color: white; width: 100%; max-width: 380px; padding: 14px 20px; font-size: 1rem; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3); margin-bottom: 15px;">
        📲 Join Official NSS WhatsApp Group
      </a>

      <div>
        <a href="/" class="btn btn-secondary" style="margin-top: 10px;">Submit Another Registration</a>
      </div>
    </div>
  </main>
</body>
</html>
