<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; padding-top: 40px; padding-bottom: 60px;">
    <div class="track-wrapper">
      <div class="track-card" style="text-align: center;">
        
        <div class="track-logo-group" style="margin-bottom: 16px;">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 52px; width: auto; object-fit: contain;" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" style="height: 52px; width: auto; object-fit: contain; border-radius: 6px;" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 52px; width: auto; object-fit: contain; border-radius: 50%;" title="National Service Scheme">
        </div>

        <div style="font-size: 3.5rem; margin-bottom: 8px; animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);">🎉</div>
        <h1 style="color: var(--color-navy); margin-bottom: 6px; font-size: 2rem; font-weight: 800;">Registration Successful!</h1>
        <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 28px;">Welcome to the Pondicherry University NSS Wing family!</p>

        <div style="background: rgba(255, 255, 255, 0.9); border: 2px dashed var(--color-navy); padding: 24px; border-radius: var(--radius-lg); margin-bottom: 28px; box-shadow: var(--shadow-sm);">
          <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Your Official Registration ID</span>
          <div style="font-size: 2.3rem; font-weight: 800; color: var(--color-nss-red); letter-spacing: 1px; margin-top: 6px;">
            <%= registration.registration_id %>
          </div>
          <div style="margin-top: 10px; font-size: 0.98rem; color: var(--color-navy); font-weight: 600;">
            Assigned Unit: <span class="status-tag" style="font-size: 0.85rem; padding: 4px 12px; background: rgba(15, 32, 66, 0.08); color: var(--color-navy); border-color: rgba(15, 32, 66, 0.2);"><%= registration.unit_number %></span>
          </div>
        </div>

        <!-- Important Notes Box -->
        <div class="whatsapp-box" style="text-align: left;">
          <div class="whatsapp-box-title">
            <span>📌</span> Important Notes:
          </div>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px;">
            <li><strong>Please save this Registration ID for future reference, event participation, and certificate generation.</strong></li>
            <li><strong>Join the WhatsApp group for further updates on the selection process: <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline; font-weight: 800;">Click Here to Join WhatsApp Group</a></strong></li>
            <li><strong>Please take a printout of your application form receipt for the selection interview.</strong></li>
          </ul>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; margin-bottom: 28px;">
          <a href="/track-registration/pdf/<%= registration.registration_id %>" class="pdf-download-btn" style="width: 100%; max-width: 460px; height: 50px; font-size: 1.05rem;">
            📥 Download / Print Application Form Receipt (PDF)
          </a>

          <!-- WhatsApp Group Button -->
          <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" class="whatsapp-link-btn" style="width: 100%; max-width: 460px; height: 50px; font-size: 1.05rem;">
            📲 Join Selection WhatsApp Group
          </a>
        </div>

        <div style="display: flex; gap: 15px; justify-content: center; margin-top: 15px;">
          <a href="/track-registration" class="btn btn-secondary" style="padding: 10px 24px; font-size: 0.95rem;">Track Status</a>
          <a href="/" class="btn btn-ghost" style="padding: 10px 24px; font-size: 0.95rem;">Back to Home</a>
        </div>

      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
