<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px;">
    <div class="track-wrapper">
      <div class="track-card" style="text-align: center;">
        
        <div class="track-logo-group" style="margin-bottom: 16px;">
          <img src="/images/pondilogo.png" alt="Pondicherry University Logo" title="Pondicherry University">
          <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" class="logo-40yrs" title="40 Years of Excellence">
          <img src="/images/nsslogo.jpg" alt="NSS Logo" class="logo-nss" title="National Service Scheme">
        </div>

        <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: rgba(22, 163, 74, 0.12); color: #16A34A; border-radius: 50%; margin-bottom: 12px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h1 style="color: var(--color-navy); margin-bottom: 6px; font-size: clamp(1.4rem, 4vw, 2rem); font-weight: 800; overflow-wrap: break-word;">Registration Successful!</h1>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 24px; overflow-wrap: break-word;">Welcome to the Pondicherry University NSS Wing family!</p>

        <div style="background: rgba(255, 255, 255, 0.9); border: 2px dashed var(--color-navy); padding: 18px 14px; border-radius: var(--radius-lg); margin-bottom: 24px; box-shadow: var(--shadow-sm); box-sizing: border-box;">
          <span style="font-size: 0.8rem; color: var(--color-text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">Your Official Registration ID</span>
          <div style="font-size: clamp(1.2rem, 5.5vw, 2.2rem); font-weight: 800; color: var(--color-nss-red); letter-spacing: 0.5px; margin-top: 6px; overflow-wrap: anywhere; word-break: break-all;">
            <%= registration.registration_id %>
          </div>
          <div style="margin-top: 8px; font-size: 0.92rem; color: var(--color-navy); font-weight: 600;">
            Assigned Unit: <span class="status-tag" style="font-size: 0.82rem; padding: 4px 12px; background: rgba(15, 32, 66, 0.08); color: var(--color-navy); border-color: rgba(15, 32, 66, 0.2);"><%= registration.unit_number %></span>
          </div>
        </div>

        <!-- Important Notes Box -->
        <div class="whatsapp-box" style="text-align: left;">
          <div class="whatsapp-box-title">
            <span><svg style="display:inline-block; vertical-align:-2px; margin-right:4px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span> Important Notes:
          </div>
          <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>Please save this Registration ID for future reference, event participation, and certificate generation.</strong></li>
            <li><strong>Join the WhatsApp group for further updates on the selection process: <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline; font-weight: 800; overflow-wrap: anywhere; word-break: break-word;">Click Here to Join WhatsApp Group</a></strong></li>
            <li><strong>Please take a printout of your application form receipt for the selection interview.</strong></li>
          </ul>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; align-items: center; margin-bottom: 24px; width: 100%;">
          <a href="/track-registration/pdf/<%= registration.registration_id %>" class="pdf-download-btn" style="width: 100%; max-width: 460px; min-height: 48px; height: auto; padding: 12px 14px; font-size: 0.95rem; text-align: center; white-space: normal; line-height: 1.35;">
            <svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg> Download / Print Application Form Receipt (PDF)
          </a>

          <!-- WhatsApp Group Button -->
          <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" class="whatsapp-link-btn" style="width: 100%; max-width: 460px; min-height: 48px; height: auto; padding: 12px 14px; font-size: 0.95rem; text-align: center; white-space: normal; line-height: 1.35;">
            <svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.206 8.206 0 0 1-5.82 2.42c-1.42 0-2.82-.37-4.05-1.08l-.29-.17-3.01.79.8-2.93-.19-.3A8.196 8.196 0 0 1 3.8 11.91c0-4.54 3.7-8.24 8.25-8.24zm4.52 10.3c-.25-.13-1.47-.73-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.65.81-.8 1-.15.18-.3.2-.55.07-.25-.13-1.05-.39-2.01-1.24-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.01 2.58.13.17 1.76 2.69 4.27 3.77.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.11-.22-.17-.47-.3z"/></svg> Join Selection WhatsApp Group
          </a>
        </div>

        <div style="display: flex; gap: 12px; justify-content: center; margin-top: 15px; flex-wrap: wrap;">
          <a href="/track-registration" class="btn btn-secondary" style="padding: 10px 20px; font-size: 0.92rem; min-height: 44px;">Track Status</a>
          <a href="/" class="btn btn-ghost" style="padding: 10px 20px; font-size: 0.92rem; min-height: 44px;">Back to Home</a>
        </div>

      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
