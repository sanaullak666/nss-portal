<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; padding-top: 30px; padding-bottom: 60px;">
    <div class="track-wrapper">
      <div class="track-card">

        <!-- Header Section -->
        <div class="track-header">
          <div class="track-logo-group">
            <img src="/images/pondilogo.png" alt="Pondicherry University Logo" title="Pondicherry University">
            <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" class="logo-40yrs" title="40 Years of Excellence">
            <img src="/images/nsslogo.jpg" alt="NSS Logo" class="logo-nss" title="National Service Scheme">
          </div>
          <h1>Track Volunteer Application Status</h1>
          <p>Enter your Registration ID, University Register Number, Email, Mobile, or Aadhaar Number</p>
        </div>

        <!-- Search Form -->
        <form action="/track-registration" method="POST" style="margin-bottom: 20px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="search-box-group">
            <input type="text" name="query" class="search-input" placeholder="e.g. PU-NSS-2026-UNIT1-000001 or 25MCA00PY0085" required oninput="this.value = this.value.toUpperCase()">
            <button type="submit" class="search-btn"><svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg> Search Application</button>
          </div>
        </form>

        <% if (error) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 14px 18px; border-radius: var(--radius-md); text-align: center; margin-bottom: 20px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; justify-content: center; gap: 8px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
            <div><strong>Status Check Notice:</strong> <%= error %></div>
          </div>
        <% } %>

        <% if (registration) { %>
          <div class="result-card">
            <div class="result-header">
              <div>
                <h3 class="applicant-title"><%= registration.applicant_name %></h3>
                <div class="reg-id-badge">Registration ID: <strong><%= registration.registration_id %></strong></div>
              </div>
              <% if (registration.status === 'Selected') { %>
                <span class="status-tag" style="background: #dcfce7; color: #15803d; border-color: #bbf7d0; font-weight: 800;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24" style="display:inline-block; vertical-align:-2px; margin-right:4px; color: #16a34a;"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l4.004-5.606z" clip-rule="evenodd" /></svg> Status: Selected</span>
              <% } else if (registration.status === 'Rejected') { %>
                <span class="status-tag" style="background: #fee2e2; color: #b91c1c; border-color: #fecaca; font-weight: 800;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24" style="display:inline-block; vertical-align:-2px; margin-right:4px; color: #dc2626;"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z" clip-rule="evenodd" /></svg> Status: Rejected</span>
              <% } else { %>
                <span class="status-tag" style="background: #e0f2fe; color: #0369a1; border-color: #bae6fd; font-weight: 800;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24" style="display:inline-block; vertical-align:-2px; margin-right:4px; color: #0284c7;"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .2.079.39.22.53l3.5 3.5a.75.75 0 001.06-1.06l-3.28-3.28V6z" clip-rule="evenodd" /></svg> Status: Active (Under Review)</span>
              <% } %>
            </div>

            <div class="details-grid">
              <div class="details-item"><strong>NSS Unit:</strong> <span style="color: var(--color-navy); font-weight: 700;"><%= registration.unit_number %></span></div>
              <div class="details-item"><strong>Univ Reg No:</strong> <%= registration.univ_reg_no %></div>
              <div class="details-item"><strong>Course:</strong> <%= registration.course %></div>
              <div class="details-item"><strong>Department:</strong> <%= registration.department %></div>
              <div class="details-item"><strong>Year of Study:</strong> <%= registration.year_of_study %></div>
              <div class="details-item"><strong>Registration Date:</strong> <%= new Date(registration.created_at).toLocaleDateString('en-IN') %></div>
            </div>

            <!-- Selection Status Box -->
            <% if (registration.status === 'Selected') { %>
              <div class="whatsapp-box" style="background: #f0fdf4; border-color: #16a34a;">
                <div class="whatsapp-box-title" style="color: #15803d;">
                  <span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-3px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg></span> Congratulations! You are Selected!
                </div>
                <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px;">
                  <li><strong style="color: #15803d;">You have been officially selected as an NSS Volunteer for Pondicherry University (Batch 2026).</strong></li>
                  <li><strong>Your assigned NSS Unit Coordinator will contact you directly and add you to the official NSS Volunteers group.</strong></li>
                  <li><strong>Please download and preserve your official selection receipt for verification.</strong></li>
                </ul>
              </div>

              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <a href="/track-registration/pdf/<%= registration.registration_id %>" class="pdf-download-btn" style="max-width: 320px;">
                  <svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg> Download Selection Receipt (PDF)
                </a>
              </div>

            <% } else if (registration.status === 'Rejected') { %>
              <div class="whatsapp-box" style="background: #fef2f2; border-color: #ef4444;">
                <div class="whatsapp-box-title" style="color: #b91c1c;">
                  <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-3px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg></span> Selection Status Notice
                </div>
                <p style="margin: 0; color: #7f1d1d; font-size: 0.95rem; line-height: 1.5;">
                  Thank you for applying to the National Service Scheme (NSS), Pondicherry University. We appreciate your interest in community service. 
                  Unfortunately, you have not been selected for the current volunteer batch.
                </p>
              </div>

            <% } else { %>
              <div class="whatsapp-box">
                <div class="whatsapp-box-title">
                  <span><svg style="display:inline-block; vertical-align:-2px; margin-right:4px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span> Selection Process Instructions:
                </div>
                <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px;">
                  <li><strong>Your application is active and under review for the volunteer selection process.</strong></li>
                  <li><strong>Join the WhatsApp group for updates on the selection process: <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline; font-weight: 800;">Click Here to Join Selection WhatsApp Group</a></strong></li>
                  <li><strong>Please take a printout of your application receipt for the selection interview.</strong></li>
                </ul>
              </div>

              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <a href="/track-registration/pdf/<%= registration.registration_id %>" class="pdf-download-btn">
                  <svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg> Download Application Form Receipt (PDF)
                </a>
                <a href="https://chat.whatsapp.com/C9CDzrf616b9VgzbayKWF3?s=qt&p=a&ilr=1" target="_blank" rel="noopener noreferrer" class="whatsapp-link-btn">
                  <svg style="display:inline-block; vertical-align:-2px; margin-right:6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.206 8.206 0 0 1-5.82 2.42c-1.42 0-2.82-.37-4.05-1.08l-.29-.17-3.01.79.8-2.93-.19-.3A8.196 8.196 0 0 1 3.8 11.91c0-4.54 3.7-8.24 8.25-8.24zm4.52 10.3c-.25-.13-1.47-.73-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.65.81-.8 1-.15.18-.3.2-.55.07-.25-.13-1.05-.39-2.01-1.24-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.01 2.58.13.17 1.76 2.69 4.27 3.77.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.11-.22-.17-.47-.3z"/></svg> Join Selection WhatsApp Group
                </a>
              </div>
            <% } %>

          </div>
        <% } %>

      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
