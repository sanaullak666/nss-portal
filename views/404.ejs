<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | PU NSS Portal</title>
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: clamp(20px, 4vw, 50px) clamp(10px, 2vw, 20px);">
    <div class="track-card" style="text-align: center; max-width: 520px; width: 100%; padding: clamp(24px, 5vw, 45px) clamp(16px, 4vw, 35px); box-sizing: border-box;">
      <div style="margin-bottom: 10px; color: var(--color-nss-red);">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
      </div>
      <h1 style="font-size: clamp(2.5rem, 8vw, 3.5rem); color: var(--color-nss-red); font-weight: 800; margin: 0; line-height: 1;">404</h1>
      <h2 style="color: var(--color-navy); margin-top: 10px; margin-bottom: 10px; font-weight: 800; font-size: clamp(1.3rem, 4vw, 1.6rem);">Page Not Found</h2>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 28px; line-height: 1.5; overflow-wrap: break-word;">The page or resource you are looking for does not exist or has been moved.</p>
      
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary" style="padding: 10px 20px; font-size: 0.92rem;">Return to Registration Form</a>
        <a href="/track-registration" class="btn btn-secondary" style="padding: 10px 20px; font-size: 0.92rem;">Track Status</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
