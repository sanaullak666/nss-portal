<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>403 - Access Denied | PU NSS Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="card" style="text-align: center; max-width: 500px; padding: 40px;">
      <h1 style="font-size: 4rem; color: var(--nss-red); margin: 0;">403</h1>
      <h2 style="color: var(--nss-navy);">Access Forbidden</h2>
      <p style="color: var(--gray-600); margin-bottom: 25px;">You do not have permission to view or access this administrative resource.</p>
      <a href="/admin/login" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
