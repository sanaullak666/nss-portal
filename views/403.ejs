<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 - Access Forbidden | PU NSS Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/track.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="track-page-body" style="display: flex; flex-direction: column; min-height: 100vh;">

  <!-- Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 50px 20px;">
    <div class="track-card" style="text-align: center; max-width: 520px; width: 100%; padding: 45px 35px;">
      <div style="font-size: 3.5rem; margin-bottom: 10px;">🔒</div>
      <h1 style="font-size: 3.5rem; color: var(--color-nss-red); font-weight: 800; margin: 0; line-height: 1;">403</h1>
      <h2 style="color: var(--color-navy); margin-top: 10px; margin-bottom: 10px; font-weight: 800;">Access Forbidden</h2>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 28px; line-height: 1.5;">You do not have permission to access this page or perform this action.</p>
      
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary" style="padding: 12px 24px;">Registration Form</a>
        <a href="/admin/login" class="btn btn-secondary" style="padding: 12px 24px;">Admin Login</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
