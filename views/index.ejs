<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Registration · Main page' %></title>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <!-- Responsive Registration Form Stylesheet -->
  <link rel="stylesheet" href="/css/register.css">
</head>
<body>

  <!-- ========== HEADER (Theme, Logo & Branding Preserved Exactly) ========== -->
  <header class="main-header">
    <div class="logo-area">
      <div class="logo-icon">
        <i class="fas fa-cube"></i>
      </div>
      <div class="logo-text">
        Tech<span>Nest</span>
      </div>
    </div>
    <div class="theme-tag">
      <i class="fas fa-paint-brush" style="margin-right: 6px;"></i> Theme · Indigo
    </div>
  </header>

  <!-- ========== MAIN CONTENT - FULLY RESPONSIVE REGISTRATION SECTION ========== -->
  <div class="registration-container">
    <div class="registration-card">
      
      <!-- Form Header -->
      <div class="form-header">
        <h2>Create account</h2>
        <p>Join our community in less than a minute</p>
      </div>

      <!-- Optional Alert Message Display -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: #fee2e2; color: #b71c1c; padding: 12px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 0.9rem; border-left: 4px solid #0b2b4f; display: flex; align-items: center; gap: 8px;">
          <i class="fas fa-exclamation-circle" style="flex-shrink: 0;"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Registration Form -->
      <form id="registrationForm" action="/register" method="POST" novalidate onsubmit="event.preventDefault(); /* UI Only */">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        
        <!-- Full Name Field -->
        <div class="input-group">
          <label for="fullName"><i class="fas fa-user"></i> Full name</label>
          <input type="text" id="fullName" name="fullName" placeholder="e.g. Alex Morgan" autocomplete="name" required value="<%= typeof formData !== 'undefined' && formData.fullName ? formData.fullName : '' %>">
        </div>

        <!-- Email Field -->
        <div class="input-group">
          <label for="email"><i class="fas fa-envelope"></i> Email address</label>
          <input type="email" id="email" name="email" placeholder="hello@example.com" autocomplete="email" required value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
        </div>

        <!-- Password Field with Hint -->
        <div class="input-group">
          <label for="password"><i class="fas fa-lock"></i> Password</label>
          <input type="password" id="password" name="password" placeholder="Create a strong password" autocomplete="new-password" required>
          <div class="password-hint">
            <i class="fas fa-circle-info"></i> Use 8+ characters with a mix of letters & numbers
          </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="input-group">
          <label for="confirmPassword"><i class="fas fa-check-circle"></i> Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter your password" autocomplete="off" required>
        </div>

        <!-- Terms & Conditions Checkbox -->
        <div class="terms-check">
          <input type="checkbox" id="termsCheckbox" name="terms" required>
          <label for="termsCheckbox">
            I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
          </label>
        </div>

        <!-- Register Button (Touch-friendly 48px target) -->
        <button type="submit" id="submitBtn" class="register-btn">
          <i class="fas fa-user-plus"></i> Register now
        </button>

        <!-- Small Redirect to Login -->
        <div class="login-redirect">
          Already have an account? <a href="/admin/login">Sign in</a>
        </div>

      </form>
    </div>
  </div>

</body>
</html>
