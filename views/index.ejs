<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Official NSS Volunteer Registration Portal for Pondicherry University. Register for National Service Scheme units, events, and media roles.">
  <link rel="icon" type="image/jpeg" href="/images/nsslogo.jpg">
  <link rel="shortcut icon" href="/images/nsslogo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="register-page-body">

  <!-- Background Floating Particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <%- include('partials/header') %>

  <main class="container" style="padding-top: 20px; padding-bottom: 60px;">
    <div class="register-wrapper">
      <div class="register-card">

        <!-- Brand Header -->
        <div class="register-header">
          <div class="logo-wrapper">
            <img src="/images/pondilogo.png" alt="Pondicherry University Logo" style="height: 52px; width: auto; object-fit: contain;" title="Pondicherry University">
            <img src="/images/40yearslogo.jpg" alt="40 Years Celebration Logo" style="height: 52px; width: auto; object-fit: contain; border-radius: 6px;" title="40 Years of Excellence">
            <img src="/images/nsslogo.jpg" alt="NSS Logo" style="height: 52px; width: auto; object-fit: contain; border-radius: 50%;" title="National Service Scheme">
          </div>
          <h1>NSS Volunteer Registration Portal 2026</h1>
          <span class="subtitle">National Service Scheme • Pondicherry University Wing</span>
          <div class="motto">"Not Me But You"</div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 25px; border-left: 4px solid var(--color-nss-red); display: flex; align-items: center; gap: 10px;">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg></span>
            <div><strong>Registration Error:</strong> <%= error %></div>
          </div>
        <% } %>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-error" style="background: #fee2e2; color: #b71c1c; padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 25px; border-left: 4px solid var(--color-nss-red);">
            <strong style="display: block; margin-bottom: 6px; font-size: 0.95rem;">Please fix the following validation errors:</strong>
            <ul style="margin-left: 20px; font-size: 0.9rem; line-height: 1.6;">
              <% errors.forEach(function(err) { %>
                <li><%= err.msg %></li>
              <% }); %>
            </ul>
            <% if (errors.some(e => e.msg && e.msg.includes('already exists'))) { %>
              <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #fca5a5; font-size: 0.88rem; color: #991b1b;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg> <strong>Already registered?</strong> You can check your registration status or download your registration slip on the 
                <a href="/track-registration" style="color: #7f1d1d; font-weight: 700; text-decoration: underline;">Track Registration Page</a>.
              </div>
            <% } %>
          </div>
        <% } %>

        <form id="registrationForm" action="/register" method="POST" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- SECTION 1: Personal Details -->
          <div class="section-header">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg></span> Personal Information
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="applicant_name">Full Name (As given in 10th certificate) <span class="required">*</span></label>
              <input type="text" id="applicant_name" name="applicant_name" class="form-control" placeholder="Enter full name as per 10th certificate" required value="<%= typeof formData !== 'undefined' && formData.applicant_name ? formData.applicant_name : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="univ_reg_no">University Register / Application No. <span class="required">*</span></label>
              <input type="text" id="univ_reg_no" name="univ_reg_no" class="form-control" placeholder="e.g. 25MCA00PY0085" required style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" value="<%= typeof formData !== 'undefined' && formData.univ_reg_no ? formData.univ_reg_no : '' %>">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" class="form-control" placeholder="student@pondiuni.ac.in" required value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="contact_number">Contact Mobile Number (WhatsApp Enabled) <span class="required">*</span></label>
              <input type="tel" id="contact_number" name="contact_number" class="form-control" placeholder="10-digit mobile number" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" title="Enter a valid 10-digit mobile number starting with 6, 7, 8, or 9" value="<%= typeof formData !== 'undefined' && formData.contact_number ? formData.contact_number : '' %>">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="alt_contact_number">Alternate Contact Number</label>
              <input type="tel" id="alt_contact_number" name="alt_contact_number" class="form-control" placeholder="10-digit mobile number (Optional)" inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" title="Enter a valid 10-digit mobile number starting with 6, 7, 8, or 9" value="<%= typeof formData !== 'undefined' && formData.alt_contact_number ? formData.alt_contact_number : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="gender">Gender <span class="required">*</span></label>
              <select id="gender" name="gender" class="form-control" required>
                <option value="">-- Select Gender --</option>
                <option value="Male" <%= typeof formData !== 'undefined' && formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= typeof formData !== 'undefined' && formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
                <option value="Transgender" <%= typeof formData !== 'undefined' && formData.gender === 'Transgender' ? 'selected' : '' %>>Transgender</option>
                <option value="Prefer not to say" <%= typeof formData !== 'undefined' && formData.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
              </select>
            </div>
          </div>

          <div class="register-dob-grid">
            <div class="form-group">
              <label class="form-label" for="dob">Date of Birth <span class="required">*</span></label>
              <input type="date" id="dob" name="dob" class="form-control" required value="<%= typeof formData !== 'undefined' && formData.dob ? formData.dob : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="age">Age <span class="required">*</span></label>
              <input type="number" id="age" name="age" class="form-control" placeholder="Age" required min="15" max="60" value="<%= typeof formData !== 'undefined' && formData.age ? formData.age : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="blood_group">Blood Group <span class="required">*</span></label>
              <select id="blood_group" name="blood_group" class="form-control" required>
                <option value="">-- Select --</option>
                <% if (typeof constants !== 'undefined' && constants.BLOOD_GROUPS) { %>
                  <% constants.BLOOD_GROUPS.forEach(function(bg) { %>
                    <option value="<%= bg %>" <%= typeof formData !== 'undefined' && formData.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="aadhaar_number">Aadhaar Number <span class="required">*</span></label>
              <input type="text" id="aadhaar_number" name="aadhaar_number" class="form-control" placeholder="12-digit Aadhaar Number" required inputmode="numeric" pattern="[0-9]{12}" maxlength="12" autocomplete="off" title="Aadhaar number must contain exactly 12 numeric digits" value="<%= typeof formData !== 'undefined' && formData.aadhaar_number ? formData.aadhaar_number : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="native_state">Native State / UT <span class="required">*</span></label>
              <select id="native_state" name="native_state" class="form-control" required>
                <option value="">-- Select Native State / UT --</option>
                <% if (typeof constants !== 'undefined' && constants.NATIVE_STATES) { %>
                  <% constants.NATIVE_STATES.forEach(function(state) { %>
                    <option value="<%= state %>" <%= typeof formData !== 'undefined' && formData.native_state === state ? 'selected' : '' %>><%= state %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <!-- SECTION 2: Academic Details -->
          <div class="section-header">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147L12 14.6l7.74-4.453a1.5 1.5 0 000-2.594L12 3.1 4.26 7.553a1.5 1.5 0 000 2.594z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 12v4.5c0 1.25 2.686 2.25 6 2.25s6-1 6-2.25V12" /></svg></span> Academic Information & Unit Assignment
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="department">Department / Centre / School <span class="required">*</span></label>
              <select name="department" id="department" class="form-control" required>
                <option value="">-- Select Department --</option>
                <% if (typeof constants !== 'undefined' && constants.DEPARTMENT_UNIT_MAP) { %>
                  <% Object.keys(constants.DEPARTMENT_UNIT_MAP).forEach(function(unitKey) { %>
                    <optgroup label="<%= unitKey %>">
                      <% constants.DEPARTMENT_UNIT_MAP[unitKey].forEach(function(dept) { %>
                        <option value="<%= dept %>" data-unit="<%= unitKey %>" <%= typeof formData !== 'undefined' && formData.department === dept ? 'selected' : '' %>><%= dept %></option>
                      <% }); %>
                    </optgroup>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="course">Course / Programme <span class="required">*</span></label>
              <select name="course" id="course" class="form-control" required>
                <option value="">-- Select Course --</option>
                <% if (typeof constants !== 'undefined' && constants.COURSES) { %>
                  <% constants.COURSES.forEach(function(courseItem) { %>
                    <option value="<%= courseItem %>" <%= typeof formData !== 'undefined' && formData.course === courseItem ? 'selected' : '' %>><%= courseItem %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="year_of_study">Year of Study <span class="required">*</span></label>
              <select name="year_of_study" id="year_of_study" class="form-control" required>
                <option value="">-- Select Year --</option>
                <% if (typeof constants !== 'undefined' && constants.YEAR_OF_STUDY) { %>
                  <% constants.YEAR_OF_STUDY.forEach(function(yr) { %>
                    <option value="<%= yr %>" <%= typeof formData !== 'undefined' && formData.year_of_study === yr ? 'selected' : '' %>><%= yr %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="unit_number_display">Mapped NSS Unit Number <span class="required">*</span></label>
              <input type="text" id="unit_number_display" class="form-control" placeholder="Auto-mapped NSS Unit" readonly style="background-color: #f1f5f9; cursor: not-allowed; font-weight: 700; color: var(--color-navy);" value="<%= typeof formData !== 'undefined' && formData.unit_number ? formData.unit_number : '' %>">
              <input type="hidden" name="unit_number" id="unit_number" value="<%= typeof formData !== 'undefined' && formData.unit_number ? formData.unit_number : '' %>">
            </div>
          </div>

          <!-- SECTION 3: Address Details -->
          <div class="section-header">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg></span> Address Information
          </div>

          <div class="form-group">
            <label class="form-label" for="present_address">Present Address (Puducherry / Campus Hostel) <span class="required">*</span></label>
            <textarea id="present_address" name="present_address" class="form-control" rows="2" placeholder="Street, Room/Hostel No., City, Pincode" required><%= typeof formData !== 'undefined' && formData.present_address ? formData.present_address : '' %></textarea>
          </div>

          <div style="margin-bottom: 14px;">
            <label class="custom-check">
              <input type="checkbox" id="is_same_address" name="is_same_address" value="1" <%= typeof formData !== 'undefined' && (formData.is_same_address === '1' || formData.is_same_address === 'on') ? 'checked' : '' %>>
              <span>Permanent Address is same as Present Address</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-label" for="permanent_address">Permanent Address <span class="required">*</span></label>
            <textarea id="permanent_address" name="permanent_address" class="form-control" rows="2" placeholder="Native/Home Address, Pincode" required><%= typeof formData !== 'undefined' && formData.permanent_address ? formData.permanent_address : '' %></textarea>
          </div>

          <!-- SECTION 4: Language Proficiency -->
          <div class="section-header">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a.75.75 0 01-1.074-.85 5.977 5.977 0 011.603-2.55C4.053 16.035 3 14.12 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg></span> Language Proficiency
          </div>

          <div class="form-group">
            <label class="form-label">Select Languages Spoken & Written <span class="required">*</span></label>
            <div class="register-languages-grid">
              <% 
                let selectedLangs = [];
                if (typeof formData !== 'undefined' && formData.languages_spoken) {
                  if (Array.isArray(formData.languages_spoken)) selectedLangs = formData.languages_spoken;
                  else if (typeof formData.languages_spoken === 'string') selectedLangs = formData.languages_spoken.split(',').map(s => s.trim());
                }
              %>
              <% if (typeof constants !== 'undefined' && constants.INDIAN_LANGUAGES) { %>
                <% constants.INDIAN_LANGUAGES.forEach(function(lang) { %>
                  <label class="custom-check">
                    <input type="checkbox" name="languages_spoken[]" value="<%= lang %>" <%= selectedLangs.includes(lang) ? 'checked' : '' %>>
                    <span><%= lang %></span>
                  </label>
                <% }); %>
              <% } %>
            </div>
          </div>

          <!-- SECTION 5: NSS Experience, Media Roles & Leadership -->
          <div class="section-header">
            <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg></span> NSS History, Media Roles & Leadership Interest
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="is_previous_volunteer">Have you been an NSS Volunteer previously? <span class="required">*</span></label>
              <select id="is_previous_volunteer" name="is_previous_volunteer" class="form-control" required>
                <option value="No" <%= typeof formData !== 'undefined' && formData.is_previous_volunteer === 'No' ? 'selected' : '' %>>No</option>
                <option value="Yes" <%= typeof formData !== 'undefined' && formData.is_previous_volunteer === 'Yes' ? 'selected' : '' %>>Yes</option>
              </select>
            </div>

            <div class="form-group" id="certificate_group" style="display: none;">
              <label class="form-label" for="certificate">Upload NSS Certificate / ID Card (PDF, JPG, PNG - Max 150 KB)</label>
              <input type="file" id="certificate" name="certificate" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
              <small id="file-error" style="color: #dc3545; display: none; margin-top: 4px; font-weight: 500;"></small>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="interested_in_media">Interested in Media / PR / Documentation Team? <span class="required">*</span></label>
              <select id="interested_in_media" name="interested_in_media" class="form-control" required>
                <option value="No" <%= typeof formData !== 'undefined' && formData.interested_in_media === 'No' ? 'selected' : '' %>>No</option>
                <option value="Yes" <%= typeof formData !== 'undefined' && formData.interested_in_media === 'Yes' ? 'selected' : '' %>>Yes</option>
              </select>
            </div>
          </div>

          <div class="form-group" id="media_roles_group" style="display: none;">
            <label class="form-label">Select Preferred Media / Creative Roles:</label>
            <div class="register-media-grid">
              <% 
                let selectedRoles = [];
                if (typeof formData !== 'undefined' && formData.media_roles) {
                  if (Array.isArray(formData.media_roles)) selectedRoles = formData.media_roles;
                  else if (typeof formData.media_roles === 'string') selectedRoles = formData.media_roles.split(',').map(s => s.trim());
                }
              %>
              <% if (typeof constants !== 'undefined' && constants.MEDIA_ROLES) { %>
                <% constants.MEDIA_ROLES.forEach(function(role) { %>
                  <label class="custom-check">
                    <input type="checkbox" name="media_roles[]" value="<%= role %>" <%= selectedRoles.includes(role) ? 'checked' : '' %>>
                    <span><%= role %></span>
                  </label>
                <% }); %>
              <% } %>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="extra_curricular_skills">Extra Curricular Skills (Mention if any)</label>
            <textarea id="extra_curricular_skills" name="extra_curricular_skills" class="form-control" rows="2" placeholder="e.g. Sports, Music, Dance, Public Speaking, Fine Arts, First Aid, Event Management"><%= typeof formData !== 'undefined' && formData.extra_curricular_skills ? formData.extra_curricular_skills : '' %></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="interested_in_leadership">Are you interested in being a leader in NSS PU? <span class="required">*</span></label>
            <select id="interested_in_leadership" name="interested_in_leadership" class="form-control" required>
              <option value="">-- Select Option --</option>
              <option value="No" <%= typeof formData !== 'undefined' && formData.interested_in_leadership === 'No' ? 'selected' : '' %>>No</option>
              <option value="Yes" <%= typeof formData !== 'undefined' && formData.interested_in_leadership === 'Yes' ? 'selected' : '' %>>Yes</option>
            </select>
          </div>

          <!-- SECTION 6: Declaration & Submit -->
          <div class="declaration-box">
            <label class="custom-check" style="align-items: flex-start;">
              <input type="checkbox" id="declaration_accepted" name="declaration_accepted" value="1" required style="margin-top: 3px;">
              <span style="font-size: 0.9rem; line-height: 1.5; color: var(--color-text-secondary);">
                <strong>Student Declaration:</strong> I hereby declare that all the information provided in this volunteer application form is authentic, accurate, and complete. If selected, I agree to abide by the rules, discipline, and community service code of the National Service Scheme (NSS), Pondicherry University.
              </span>
            </label>
          </div>

          <button type="submit" id="submitBtn" class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.1rem; justify-content: center; letter-spacing: 0.5px;">
