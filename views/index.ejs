<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container" style="padding: 30px 20px;">
    <div class="card" style="max-width: 800px; margin: 0 auto; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
      <h2 style="color: var(--color-navy); margin-bottom: 10px; text-align: center;">NSS Volunteer Registration 2026</h2>
      <p style="text-align: center; color: #666; margin-bottom: 25px;">Pondicherry University</p>

      <% if (typeof success !== 'undefined' && success) { %>
        <div style="background: #d1e7dd; color: #0f5132; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
          <strong><%= success %></strong>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: #f8d7da; color: #842029; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
          <%= error %>
        </div>
      <% } %>

      <!-- 1. Single <form> opening tag encompassing ALL form sections -->
      <form id="registrationForm" action="/register?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- SECTION: Personal Details -->
        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-bottom: 18px; color: var(--color-navy);">Personal Details</h3>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Full Name *</label>
            <input type="text" name="applicant_name" class="form-control" placeholder="Full name" required value="<%= typeof formData !== 'undefined' && formData.applicant_name ? formData.applicant_name : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">University Reg No. *</label>
            <input type="text" name="univ_reg_no" class="form-control" placeholder="e.g. 23352001" required pattern="[A-Za-z0-9]{5,20}" title="Enter a valid University Registration Number" value="<%= typeof formData !== 'undefined' && formData.univ_reg_no ? formData.univ_reg_no : '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" name="email" class="form-control" placeholder="Email" required value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
          </div>

          <!-- 5. Contact Number Validation -->
          <div class="form-group">
            <label class="form-label">Contact Number *</label>
            <input type="tel" name="contact_number" class="form-control" placeholder="10-digit mobile number" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" title="Enter a valid 10-digit mobile number starting with 6, 7, 8, or 9" value="<%= typeof formData !== 'undefined' && formData.contact_number ? formData.contact_number : '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <!-- 5. Alternative Contact Number Validation -->
          <div class="form-group">
            <label class="form-label">Alternate Contact Number</label>
            <input type="tel" name="alt_contact_number" class="form-control" placeholder="10-digit mobile number" inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" title="Enter a valid 10-digit mobile number starting with 6, 7, 8, or 9" value="<%= typeof formData !== 'undefined' && formData.alt_contact_number ? formData.alt_contact_number : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Gender *</label>
            <select name="gender" class="form-control" required>
              <option value="">-- Select Gender --</option>
              <option value="Male" <%= typeof formData !== 'undefined' && formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= typeof formData !== 'undefined' && formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= typeof formData !== 'undefined' && formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Date of Birth *</label>
            <input type="date" name="dob" class="form-control" required value="<%= typeof formData !== 'undefined' && formData.dob ? formData.dob : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Age *</label>
            <input type="number" name="age" class="form-control" placeholder="Age" required min="15" max="60" value="<%= typeof formData !== 'undefined' && formData.age ? formData.age : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Blood Group *</label>
            <select name="blood_group" class="form-control" required>
              <option value="">-- Select --</option>
              <option value="A+" <%= typeof formData !== 'undefined' && formData.blood_group === 'A+' ? 'selected' : '' %>>A+</option>
              <option value="A-" <%= typeof formData !== 'undefined' && formData.blood_group === 'A-' ? 'selected' : '' %>>A-</option>
              <option value="B+" <%= typeof formData !== 'undefined' && formData.blood_group === 'B+' ? 'selected' : '' %>>B+</option>
              <option value="B-" <%= typeof formData !== 'undefined' && formData.blood_group === 'B-' ? 'selected' : '' %>>B-</option>
              <option value="O+" <%= typeof formData !== 'undefined' && formData.blood_group === 'O+' ? 'selected' : '' %>>O+</option>
              <option value="O-" <%= typeof formData !== 'undefined' && formData.blood_group === 'O-' ? 'selected' : '' %>>O-</option>
              <option value="AB+" <%= typeof formData !== 'undefined' && formData.blood_group === 'AB+' ? 'selected' : '' %>>AB+</option>
              <option value="AB-" <%= typeof formData !== 'undefined' && formData.blood_group === 'AB-' ? 'selected' : '' %>>AB-</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <!-- 5. Aadhaar Number Validation -->
          <div class="form-group">
            <label class="form-label">Aadhaar Number *</label>
            <input type="text" name="aadhaar_number" class="form-control" placeholder="12-digit Aadhaar Number" required inputmode="numeric" pattern="[0-9]{12}" maxlength="12" autocomplete="off" title="Aadhaar number must contain exactly 12 numeric digits" value="<%= typeof formData !== 'undefined' && formData.aadhaar_number ? formData.aadhaar_number : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Native State *</label>
            <input type="text" name="native_state" class="form-control" placeholder="State" required value="<%= typeof formData !== 'undefined' && formData.native_state ? formData.native_state : '' %>">
          </div>
        </div>

        <!-- SECTION: Academic Details -->
        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">Academic Details</h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Department *</label>
            <select name="department" id="department" class="form-control" required>
              <option value="">-- Select Department --</option>
              <% if (typeof constants !== 'undefined' && constants.DEPARTMENT_UNIT_MAP) { %>
                <% Object.keys(constants.DEPARTMENT_UNIT_MAP).forEach(function(unit) { %>
                  <optgroup label="<%= unit %>">
                    <% constants.DEPARTMENT_UNIT_MAP[unit].forEach(function(dept) { %>
                      <option value="<%= dept %>" data-unit="<%= unit %>" <%= typeof formData !== 'undefined' && formData.department === dept ? 'selected' : '' %>><%= dept %></option>
                    <% }); %>
                  </optgroup>
                <% }); %>
              <% } else { %>
                <option value="Computer Science" data-unit="Unit I">Computer Science</option>
                <option value="Information Technology" data-unit="Unit I">Information Technology</option>
                <option value="Chemistry" data-unit="Unit II">Chemistry</option>
                <option value="Commerce" data-unit="Unit III">Commerce</option>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Course / Program *</label>
            <input type="text" name="course" class="form-control" placeholder="e.g. M.Sc / M.Tech" required value="<%= typeof formData !== 'undefined' && formData.course ? formData.course : '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Year of Study *</label>
            <select name="year_of_study" class="form-control" required>
              <option value="">-- Select Year --</option>
              <option value="1st Year" <%= typeof formData !== 'undefined' && formData.year_of_study === '1st Year' ? 'selected' : '' %>>1st Year</option>
              <option value="2nd Year" <%= typeof formData !== 'undefined' && formData.year_of_study === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
              <option value="3rd Year" <%= typeof formData !== 'undefined' && formData.year_of_study === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
            </select>
          </div>

          <!-- 2. NSS Unit Number (Read-only Display Field + Hidden Input) -->
          <div class="form-group">
            <label class="form-label">NSS Unit Number *</label>
            <input type="text" id="unit_number_display" class="form-control" placeholder="Assigned Unit" readonly style="background-color: #e9ecef; cursor: not-allowed;" value="<%= typeof formData !== 'undefined' && formData.unit_number ? formData.unit_number : '' %>">
            <input type="hidden" name="unit_number" id="unit_number" value="<%= typeof formData !== 'undefined' && formData.unit_number ? formData.unit_number : '' %>">
          </div>
        </div>

        <!-- SECTION: Address Details -->
        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">Address Details</h3>

        <div class="form-group" style="margin-bottom: 15px;">
          <label class="form-label">Present Address *</label>
          <textarea name="present_address" class="form-control" rows="2" required><%= typeof formData !== 'undefined' && formData.present_address ? formData.present_address : '' %></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
          <label class="form-label">Permanent Address *</label>
          <textarea name="permanent_address" class="form-control" rows="2" required><%= typeof formData !== 'undefined' && formData.permanent_address ? formData.permanent_address : '' %></textarea>
        </div>

        <!-- SECTION: Language Proficiency -->
        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">Language Proficiency</h3>
        <div class="form-group" style="margin-bottom: 15px;">
          <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 5px;">
            <% const currentLangs = typeof formData !== 'undefined' && formData.languages_spoken ? (Array.isArray(formData.languages_spoken) ? formData.languages_spoken : formData.languages_spoken.split(',')) : []; %>
            <!-- 4. languages_spoken[] array notation -->
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="English" <%= currentLangs.includes('English') ? 'checked' : '' %>> English</label>
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="Tamil" <%= currentLangs.includes('Tamil') ? 'checked' : '' %>> Tamil</label>
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="Hindi" <%= currentLangs.includes('Hindi') ? 'checked' : '' %>> Hindi</label>
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="Malayalam" <%= currentLangs.includes('Malayalam') ? 'checked' : '' %>> Malayalam</label>
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="Telugu" <%= currentLangs.includes('Telugu') ? 'checked' : '' %>> Telugu</label>
            <label style="font-weight: normal;"><input type="checkbox" name="languages_spoken[]" value="French" <%= currentLangs.includes('French') ? 'checked' : '' %>> French</label>
          </div>
        </div>

        <!-- SECTION: NSS Information & Media Team -->
        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">NSS Information & Media Team</h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Previous NSS Volunteer? *</label>
            <select name="is_previous_volunteer" class="form-control" required>
              <option value="No" <%= typeof formData !== 'undefined' && formData.is_previous_volunteer === 'No' ? 'selected' : '' %>>No</option>
              <option value="Yes" <%= typeof formData !== 'undefined' && formData.is_previous_volunteer === 'Yes' ? 'selected' : '' %>>Yes</option>
            </select>
          </div>

          <!-- 3. Certificate Upload (PDF, JPG, JPEG, PNG | Max 250 KB) -->
          <div class="form-group">
            <label class="form-label">Upload Certificate / ID (PDF, JPG, JPEG, PNG - Max 250 KB)</label>
            <input type="file" id="certificate" name="certificate" class="form-control" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png">
            <small id="file-error" style="color: #dc3545; display: none; margin-top: 4px;">File size exceeds maximum limit of 250 KB.</small>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label class="form-label">Interested in Media / PR Roles?</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 5px;">
            <% const currentRoles = typeof formData !== 'undefined' && formData.media_roles ? (Array.isArray(formData.media_roles) ? formData.media_roles : formData.media_roles.split(',')) : []; %>
            <!-- 4. media_roles[] array notation -->
            <label style="font-weight: normal;"><input type="checkbox" name="media_roles[]" value="Photography" <%= currentRoles.includes('Photography') ? 'checked' : '' %>> Photography</label>
            <label style="font-weight: normal;"><input type="checkbox" name="media_roles[]" value="Videography / Editing" <%= currentRoles.includes('Videography / Editing') ? 'checked' : '' %>> Videography / Editing</label>
            <label style="font-weight: normal;"><input type="checkbox" name="media_roles[]" value="Content Writing" <%= currentRoles.includes('Content Writing') ? 'checked' : '' %>> Content Writing</label>
            <label style="font-weight: normal;"><input type="checkbox" name="media_roles[]" value="Graphic Design" <%= currentRoles.includes('Graphic Design') ? 'checked' : '' %>> Graphic Design</label>
            <label style="font-weight: normal;"><input type="checkbox" name="media_roles[]" value="Social Media Handler" <%= currentRoles.includes('Social Media Handler') ? 'checked' : '' %>> Social Media Handler</label>
          </div>
        </div>

        <!-- SECTION: Declaration & Submit -->
        <div class="form-group" style="margin-bottom: 25px;">
          <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; cursor: pointer;">
            <input type="checkbox" name="declaration_accepted" value="1" required>
            I hereby declare that all provided information is accurate and authentic.
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.05rem; justify-content: center;">Submit Registration</button>
      </form> <!-- 1. Moving closing </form> tag after submit buttons -->
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const deptSelect = document.getElementById('department');
      const unitDisplay = document.getElementById('unit_number_display');
      const unitHidden = document.getElementById('unit_number');
      const certInput = document.getElementById('certificate');
      const fileError = document.getElementById('file-error');

      // 2. NSS Unit Number Dynamic Sync
      function updateUnitNumber() {
        if (!deptSelect) return;
        const selectedOption = deptSelect.options[deptSelect.selectedIndex];
        const unit = selectedOption ? selectedOption.getAttribute('data-unit') : '';
        if (unit) {
          unitDisplay.value = unit;
          unitHidden.value = unit;
        }
      }

      if (deptSelect) {
        deptSelect.addEventListener('change', updateUnitNumber);
        updateUnitNumber(); // Sync on load
      }

      // 3. 250 KB File Size Guard
      if (certInput) {
        certInput.addEventListener('change', function() {
          const file = this.files[0];
          if (file && file.size > 250 * 1024) {
            fileError.style.display = 'block';
            this.value = '';
          } else {
            fileError.style.display = 'none';
          }
        });
      }
    });
  </script>
</body>
</html>
