<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container" style="padding: 30px 20px;">
    <div class="card" style="max-width: 800px; margin: 0 auto; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
      <h2 style="color: var(--color-navy); margin-bottom: 10px; text-align: center;">NSS Volunteer Registration 2026</h2>
      <p style="text-align: center; color: #666; margin-bottom: 25px;">Pondicherry University</p>

      <% if (success) { %>
        <div style="background: #d1e7dd; color: #0f5132; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
          <strong><%= success %></strong>
        </div>
      <% } %>

      <% if (error) { %>
        <div style="background: #f8d7da; color: #842029; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
          <%= error %>
        </div>
      <% } %>

      <form action="/register?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-bottom: 18px; color: var(--color-navy);">Personal Information</h3>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Full Name *</label>
            <input type="text" name="applicant_name" class="form-control" placeholder="Full name" required value="<%= formData.applicant_name || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">University Reg No. *</label>
            <input type="text" name="univ_reg_no" class="form-control" placeholder="Reg No." required value="<%= formData.univ_reg_no || '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" name="email" class="form-control" placeholder="Email" required value="<%= formData.email || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Contact Number *</label>
            <input type="tel" name="contact_number" class="form-control" placeholder="10-digit mobile" required value="<%= formData.contact_number || '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Alternate Contact</label>
            <input type="tel" name="alt_contact_number" class="form-control" placeholder="Alt mobile" value="<%= formData.alt_contact_number || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Gender *</label>
            <select name="gender" class="form-control" required>
              <option value="">-- Select Gender --</option>
              <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Date of Birth *</label>
            <input type="date" name="dob" class="form-control" required value="<%= formData.dob || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Age *</label>
            <input type="number" name="age" class="form-control" placeholder="Age" required value="<%= formData.age || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Blood Group *</label>
            <select name="blood_group" class="form-control" required>
              <option value="">-- Select --</option>
              <option value="A+" <%= formData.blood_group === 'A+' ? 'selected' : '' %>>A+</option>
              <option value="A-" <%= formData.blood_group === 'A-' ? 'selected' : '' %>>A-</option>
              <option value="B+" <%= formData.blood_group === 'B+' ? 'selected' : '' %>>B+</option>
              <option value="B-" <%= formData.blood_group === 'B-' ? 'selected' : '' %>>B-</option>
              <option value="O+" <%= formData.blood_group === 'O+' ? 'selected' : '' %>>O+</option>
              <option value="O-" <%= formData.blood_group === 'O-' ? 'selected' : '' %>>O-</option>
              <option value="AB+" <%= formData.blood_group === 'AB+' ? 'selected' : '' %>>AB+</option>
              <option value="AB-" <%= formData.blood_group === 'AB-' ? 'selected' : '' %>>AB-</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Aadhaar Number *</label>
            <input type="text" name="aadhaar_number" class="form-control" placeholder="12-digit Aadhaar" required value="<%= formData.aadhaar_number || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Native State *</label>
            <input type="text" name="native_state" class="form-control" placeholder="State" required value="<%= formData.native_state || '' %>">
          </div>
        </div>

        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">Academic Information</h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Department *</label>
            <input type="text" name="department" class="form-control" placeholder="Department name" required value="<%= formData.department || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Course / Program *</label>
            <input type="text" name="course" class="form-control" placeholder="e.g. M.Sc / M.Tech" required value="<%= formData.course || '' %>">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Year of Study *</label>
            <select name="year_of_study" class="form-control" required>
              <option value="">-- Select Year --</option>
              <option value="1st Year" <%= formData.year_of_study === '1st Year' ? 'selected' : '' %>>1st Year</option>
              <option value="2nd Year" <%= formData.year_of_study === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
              <option value="3rd Year" <%= formData.year_of_study === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">NSS Unit Number *</label>
            <input type="text" name="unit_number" class="form-control" placeholder="e.g. Unit I" required value="<%= formData.unit_number || '' %>">
          </div>
        </div>

        <h3 style="border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin-top: 25px; margin-bottom: 18px; color: var(--color-navy);">Address & Media</h3>

        <div class="form-group" style="margin-bottom: 15px;">
          <label class="form-label">Present Address *</label>
          <textarea name="present_address" class="form-control" rows="2" required><%= formData.present_address || '' %></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
          <label class="form-label">Permanent Address *</label>
          <textarea name="permanent_address" class="form-control" rows="2" required><%= formData.permanent_address || '' %></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group">
            <label class="form-label">Previous NSS Volunteer? *</label>
            <select name="is_previous_volunteer" class="form-control" required>
              <option value="No" <%= formData.is_previous_volunteer === 'No' ? 'selected' : '' %>>No</option>
              <option value="Yes" <%= formData.is_previous_volunteer === 'Yes' ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Upload Certificate / ID (PDF/JPG, Max 5MB)</label>
            <input type="file" name="certificate" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label class="form-label">Interested in Media/PR Team?</label>
          <select name="interested_in_media" class="form-control">
            <option value="No" <%= formData.interested_in_media === 'No' ? 'selected' : '' %>>No</option>
            <option value="Yes" <%= formData.interested_in_media === 'Yes' ? 'selected' : '' %>>Yes</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 25px;">
          <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; cursor: pointer;">
            <input type="checkbox" name="declaration_accepted" value="1" required>
            I hereby declare that all provided information is accurate and authentic.
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.05rem; justify-content: center;">Submit Registration</button>
      </form>
    </div>
  </main>
</body>
</html>
