<%- include('../partials/header') %>

<div class="pu-admin-view-wrapper">
  
  <div class="pu-admin-header-bar noprint">
    <div>
      <a href="/admin/registrations" class="pu-link-btn margin-bottom-xs"><i class="fa-solid fa-arrow-left"></i> Back to Registrations</a>
      <h2 class="pu-page-title"><i class="fa-solid fa-id-card"></i> Student Volunteer Profile</h2>
      <p class="pu-page-subtitle">Registration ID: <strong class="pu-text-mono"><%= registration.registration_id %></strong></p>
    </div>
    <div class="pu-admin-header-actions">
      <button type="button" class="pu-btn pu-btn-primary" onclick="window.print()">
        <i class="fa-solid fa-print"></i> Print Application
      </button>
    </div>
  </div>

  <!-- PRINTABLE PROFILE CONTAINER -->
  <div class="pu-card pu-printable-card">
    
    <!-- Printable Document Header -->
    <div class="pu-print-header">
      <div class="pu-print-logo">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div class="pu-print-title-group">
        <h2>PONDICHERRY UNIVERSITY</h2>
        <h3>NATIONAL SERVICE SCHEME (NSS) CELL</h3>
        <p>Volunteer Registration Record - Session 2026-2027</p>
      </div>
    </div>

    <div class="pu-card-body">
      
      <!-- Key Identifiers Banner -->
      <div class="pu-profile-banner">
        <div class="pu-banner-item">
          <span class="pu-banner-label">Registration ID</span>
          <strong class="pu-banner-value pu-text-mono"><%= registration.registration_id %></strong>
        </div>
        <div class="pu-banner-item">
          <span class="pu-banner-label">Assigned NSS Unit</span>
          <span class="pu-badge pu-badge-primary pu-badge-lg"><%= registration.unit_number %></span>
        </div>
        <div class="pu-banner-item">
          <span class="pu-banner-label">Submitted On</span>
          <strong class="pu-banner-value"><%= formatDateReadable(registration.created_at) %></strong>
        </div>
      </div>

      <!-- Section 1: Academic Details -->
      <div class="pu-view-section">
        <h4 class="pu-view-section-title"><i class="fa-solid fa-graduation-cap"></i> 1. Academic Details</h4>
        <table class="pu-table pu-table-details">
          <tbody>
            <tr>
              <th width="30%">Department / Programme</th>
              <td><%= registration.department %></td>
            </tr>
            <tr>
              <th>NSS Unit Number</th>
              <td><strong><%= registration.unit_number %></strong></td>
            </tr>
            <tr>
              <th>Course</th>
              <td><%= registration.course %></td>
            </tr>
            <tr>
              <th>Year of Study</th>
              <td><%= registration.year_of_study %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 2: Personal Details -->
      <div class="pu-view-section margin-top-md">
        <h4 class="pu-view-section-title"><i class="fa-solid fa-user"></i> 2. Personal Details</h4>
        <table class="pu-table pu-table-details">
          <tbody>
            <tr>
              <th width="30%">Name of Applicant</th>
              <td><strong><%= registration.applicant_name %></strong></td>
            </tr>
            <tr>
              <th>Univ Registration / Application No</th>
              <td><span class="pu-text-mono"><%= registration.univ_reg_no %></span></td>
            </tr>
            <tr>
              <th>Email Address</th>
              <td><%= registration.email %></td>
            </tr>
            <tr>
              <th>Contact Number</th>
              <td><%= registration.contact_number %></td>
            </tr>
            <tr>
              <th>Alternative Contact Number</th>
              <td><%= registration.alt_contact_number || 'N/A' %></td>
            </tr>
            <tr>
              <th>Gender</th>
              <td><%= registration.gender %></td>
            </tr>
            <tr>
              <th>Date of Birth (Age)</th>
              <td><%= formatDateReadable(registration.dob) %> (<%= registration.age %> Years)</td>
            </tr>
            <tr>
              <th>Blood Group</th>
              <td><span class="pu-badge pu-badge-danger"><%= registration.blood_group %></span></td>
            </tr>
            <tr>
              <th>Aadhaar Number</th>
              <td><span class="pu-text-mono">[Aadhaar Redacted]</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 3: Address & Languages -->
      <div class="pu-view-section margin-top-md">
        <h4 class="pu-view-section-title"><i class="fa-solid fa-location-dot"></i> 3. Address & Languages</h4>
        <table class="pu-table pu-table-details">
          <tbody>
            <tr>
              <th width="30%">Native State / UT</th>
              <td><%= registration.native_state %></td>
            </tr>
            <tr>
              <th>Present Address</th>
              <td><%= registration.present_address %></td>
            </tr>
            <tr>
              <th>Permanent Address</th>
              <td><%= registration.permanent_address %></td>
            </tr>
            <tr>
              <th>Languages Spoken</th>
              <td>
                <% 
                  let langs = [];
                  if (typeof registration.languages_spoken === 'string') {
                    try { langs = JSON.parse(registration.languages_spoken); } catch(e) {}
                  } else if (Array.isArray(registration.languages_spoken)) {
                    langs = registration.languages_spoken;
                  }
                %>
                <%= langs.join(', ') %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 4: NSS Volunteer & Media Preference -->
      <div class="pu-view-section margin-top-md">
        <h4 class="pu-view-section-title"><i class="fa-solid fa-award"></i> 4. NSS Volunteer & Media Preference</h4>
        <table class="pu-table pu-table-details">
          <tbody>
            <tr>
              <th width="30%">Previous NSS Volunteer</th>
              <td>
                <%= registration.is_previous_volunteer %>
                <% if (registration.certificate_path) { %>
                  <a href="<%= registration.certificate_path %>" target="_blank" class="pu-btn pu-btn-xs pu-btn-outline margin-left-sm noprint">
                    <i class="fa-solid fa-file-pdf"></i> View Certificate
                  </a>
                <% } %>
              </td>
            </tr>
            <tr>
              <th>Interested in NSS Media Team</th>
              <td>
                <% if (registration.interested_in_media === 'Yes') { %>
                  <span class="pu-badge pu-badge-success">Yes</span>
                <% } else { %>
                  <span class="pu-badge pu-badge-secondary">No</span>
                <% } %>
              </td>
            </tr>
            <% if (registration.interested_in_media === 'Yes' && registration.media_roles) { %>
              <tr>
                <th>Media Team Preferred Roles</th>
                <td>
                  <% 
                    let roles = [];
                    if (typeof registration.media_roles === 'string') {
                      try { roles = JSON.parse(registration.media_roles); } catch(e) {}
                    } else if (Array.isArray(registration.media_roles)) {
                      roles = registration.media_roles;
                    }
                  %>
                  <%= roles.join(', ') %>
                </td>
              </tr>
            <% } %>
            <tr>
              <th>Declaration Accepted</th>
              <td><span class="pu-badge pu-badge-success"><i class="fa-solid fa-check"></i> Verified & Accepted</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Print Footer Signatures -->
      <div class="pu-print-signaturesOnly">
        <div class="pu-sig-box">
          <p>Signature of Applicant</p>
        </div>
        <div class="pu-sig-box">
          <p>NSS Programme Officer</p>
        </div>
      </div>

    </div>
  </div>

</div>

<%- include('../partials/footer') %>