<%- include('../partials/header') %>

<div class="pu-auth-wrapper">
  <div class="pu-card pu-auth-card">
    <div class="pu-card-header text-center">
      <div class="pu-auth-icon-wrapper">
        <i class="fa-solid fa-user-shield"></i>
      </div>
      <h3 class="pu-card-title">Administrative Portal Login</h3>
      <p class="pu-auth-subtitle">Authorized Personnel Only | Pondicherry University NSS</p>
    </div>
    
    <div class="pu-card-body">
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="pu-alert pu-alert-danger" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= errorMessage %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" id="adminLoginForm" novalidate>
        
        <!-- Username -->
        <div class="pu-form-group">
          <label for="username" class="pu-label">Username <span class="required">*</span></label>
          <div class="pu-input-icon-group">
            <span class="pu-input-icon"><i class="fa-solid fa-user"></i></span>
            <input 
              type="text" 
              id="username" 
              name="username" 
              class="pu-input pu-input-with-icon <%= errors.username ? 'is-invalid' : '' %>" 
              value="<%= oldInput.username || '' %>" 
              placeholder="Enter admin username" 
              required 
              autocomplete="username"
              autofocus
            >
          </div>
          <% if (errors.username) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.username %></div>
          <% } %>
        </div>

        <!-- Password -->
        <div class="pu-form-group margin-top-md">
          <label for="password" class="pu-label">Password <span class="required">*</span></label>
          <div class="pu-input-icon-group">
            <span class="pu-input-icon"><i class="fa-solid fa-key"></i></span>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="pu-input pu-input-with-icon <%= errors.password ? 'is-invalid' : '' %>" 
              placeholder="Enter secure password" 
              required 
              autocomplete="current-password"
            >
            <button type="button" class="pu-password-toggle-btn" id="togglePasswordBtn" title="Toggle Password Visibility">
              <i class="fa-regular fa-eye" id="togglePasswordIcon"></i>
            </button>
          </div>
          <% if (errors.password) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.password %></div>
          <% } %>
        </div>

        <!-- Form Submission -->
        <div class="pu-form-group margin-top-lg">
          <button type="submit" class="pu-btn pu-btn-primary pu-btn-block">
            <i class="fa-solid fa-right-to-bracket"></i> Authenticate & Secure Login
          </button>
        </div>

      </form>
    </div>

    <div class="pu-card-footer text-center">
      <small class="pu-help-text">
        <i class="fa-solid fa-lock"></i> Session activity is monitored and encrypted.
      </small>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>