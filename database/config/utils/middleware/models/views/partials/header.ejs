<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'NSS Registration | Pondicherry University' %></title>
  
  <!-- CSS Assets -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  
  <!-- Google Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

  <!-- University Header Banner -->
  <header class="pu-header">
    <div class="pu-container header-container">
      <div class="pu-brand">
        <div class="pu-logo-placeholder">
          <i class="fa-solid => fa-graduation-cap"></i>
        </div>
        <div class="pu-title-group">
          <h1 class="pu-main-title">PONDICHERRY UNIVERSITY</h1>
          <p class="pu-sub-title">(A Central University established under an Act of Parliament 1985)</p>
          <h2 class="pu-nss-heading">NATIONAL SERVICE SCHEME (NSS) CELL</h2>
        </div>
      </div>
      
      <% if (typeof admin !== 'undefined' && admin) { %>
        <div class="pu-header-admin-profile">
          <span class="admin-badge"><i class="fa-solid fa-user-shield"></i> <%= admin.full_name %></span>
          <a href="/admin/dashboard" class="pu-btn pu-btn-sm pu-btn-outline"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
          <a href="/admin/registrations" class="pu-btn pu-btn-sm pu-btn-outline"><i class="fa-solid fa-users"></i> Registrations</a>
          <a href="/admin/logout" class="pu-btn pu-btn-sm pu-btn-danger"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </div>
      <% } else { %>
        <div class="pu-header-actions">
          <a href="/admin/login" class="pu-btn pu-btn-sm pu-btn-outline"><i class="fa-solid fa-lock"></i> Admin Portal</a>
        </div>
      <% } %>
    </div>
  </header>

  <main class="pu-main-content">
    <div class="pu-container">