<%- include('partials/header') %>

<div class="pu-page-header">
  <h2 class="pu-page-title"><i class="fa-solid fa-file-signature"></i> NSS Volunteer Registration Form</h2>
  <p class="pu-page-subtitle">Academic Session 2026-2027 | Central Registration Portal</p>
</div>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div class="pu-alert pu-alert-danger" role="alert">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span><%= errorMessage %></span>
  </div>
<% } %>

<form action="/register?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <!-- Hidden input as fallback -->
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Rest of form inputs -->
</form>

  <!-- SECTION 1: ACADEMIC DETAILS -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-graduation-cap"></i> 1. Academic Details</h3>
    </div>
    <div class="pu-card-body">
      <div class="pu-form-grid">

        <!-- Department / Programme -->
        <div class="pu-form-group pu-col-8">
          <label for="department" class="pu-label">Department / Programme <span class="required">*</span></label>
          <select id="department" name="department" class="pu-select <%= errors.department ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Department / Programme --</option>
            <% Object.keys(departmentMapping).forEach(function(unitKey) { %>
              <optgroup label="<%= unitKey %>">
                <% departmentMapping[unitKey].forEach(function(dept) { %>
                  <option value="<%= dept %>" <%= (oldInput && oldInput.department === dept) ? 'selected' : '' %>>
                    <%= dept %>
                  </option>
                <% }); %>
              </optgroup>
            <% }); %>
          </select>
          <% if (errors.department) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.department %></div>
          <% } %>
        </div>

        <!-- NSS Unit Number (Auto-assigned & Readonly) -->
        <div class="pu-form-group pu-col-4">
          <label for="unit_number_display" class="pu-label">NSS Unit Number</label>
          <input type="text" id="unit_number_display" class="pu-input pu-input-readonly" value="<%= (oldInput && oldInput.unit_number) ? oldInput.unit_number : 'Auto-Assigned' %>" readonly placeholder="Auto-filled on department selection">
          <small class="pu-help-text">Automatically mapped based on your Department.</small>
        </div>

        <!-- Course -->
        <div class="pu-form-group pu-col-6">
          <label for="course" class="pu-label">Course <span class="required">*</span></label>
          <select id="course" name="course" class="pu-select <%= errors.course ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Course --</option>
            <% courses.forEach(function(c) { %>
              <option value="<%= c %>" <%= (oldInput && oldInput.course === c) ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
          <% if (errors.course) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.course %></div>
          <% } %>
        </div>

        <!-- Year of Study -->
        <div class="pu-form-group pu-col-6">
          <label for="year_of_study" class="pu-label">Year of Study <span class="required">*</span></label>
          <select id="year_of_study" name="year_of_study" class="pu-select <%= errors.year_of_study ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Year of Study --</option>
            <option value="First Year" <%= (oldInput && oldInput.year_of_study === 'First Year') ? 'selected' : '' %>>First Year</option>
            <option value="Second Year" <%= (oldInput && oldInput.year_of_study === 'Second Year') ? 'selected' : '' %>>Second Year</option>
            <option value="Third Year" <%= (oldInput && oldInput.year_of_study === 'Third Year') ? 'selected' : '' %>>Third Year</option>
          </select>
          <% if (errors.year_of_study) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.year_of_study %></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 2: PERSONAL DETAILS -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-user"></i> 2. Personal Details</h3>
    </div>
    <div class="pu-card-body">
      <div class="pu-form-grid">

        <!-- Name of Applicant -->
        <div class="pu-form-group pu-col-6">
          <label for="applicant_name" class="pu-label">Name of Applicant <span class="required">*</span></label>
          <input type="text" id="applicant_name" name="applicant_name" class="pu-input <%= errors.applicant_name ? 'is-invalid' : '' %>" value="<%= oldInput.applicant_name || '' %>" placeholder="As per Official University Records" required style="text-transform: uppercase;">
          <small class="pu-help-text">Alphabets and spaces only. Converted to uppercase.</small>
          <% if (errors.applicant_name) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.applicant_name %></div>
          <% } %>
        </div>

        <!-- University Reg / Application Number -->
        <div class="pu-form-group pu-col-6">
          <label for="univ_reg_no" class="pu-label">Registration / Application Number <span class="required">*</span></label>
          <input type="text" id="univ_reg_no" name="univ_reg_no" class="pu-input <%= errors.univ_reg_no ? 'is-invalid' : '' %>" value="<%= oldInput.univ_reg_no || '' %>" placeholder="e.g. 24351001" required>
          <small class="pu-help-text">Must be unique across all applicants.</small>
          <% if (errors.univ_reg_no) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.univ_reg_no %></div>
          <% } %>
        </div>

        <!-- Email Address -->
        <div class="pu-form-group pu-col-6">
          <label for="email" class="pu-label">Email Address <span class="required">*</span></label>
          <input type="email" id="email" name="email" class="pu-input <%= errors.email ? 'is-invalid' : '' %>" value="<%= oldInput.email || '' %>" placeholder="student@pondiuni.ac.in" required>
          <% if (errors.email) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.email %></div>
          <% } %>
        </div>

        <!-- Primary Contact Number -->
        <div class="pu-form-group pu-col-3">
          <label for="contact_number" class="pu-label">Contact Number <span class="required">*</span></label>
          <input type="tel" id="contact_number" name="contact_number" class="pu-input <%= errors.contact_number ? 'is-invalid' : '' %>" value="<%= oldInput.contact_number || '' %>" placeholder="10-digit Mobile Number" maxlength="10" required>
          <% if (errors.contact_number) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.contact_number %></div>
          <% } %>
        </div>

        <!-- Alternative Contact Number -->
        <div class="pu-form-group pu-col-3">
          <label for="alt_contact_number" class="pu-label">Alternative Phone Number</label>
          <input type="tel" id="alt_contact_number" name="alt_contact_number" class="pu-input <%= errors.alt_contact_number ? 'is-invalid' : '' %>" value="<%= oldInput.alt_contact_number || '' %>" placeholder="Optional 10-digit number" maxlength="10">
          <% if (errors.alt_contact_number) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.alt_contact_number %></div>
          <% } %>
        </div>

        <!-- Gender -->
        <div class="pu-form-group pu-col-3">
          <label for="gender" class="pu-label">Gender <span class="required">*</span></label>
          <select id="gender" name="gender" class="pu-select <%= errors.gender ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Gender --</option>
            <option value="Male" <%= (oldInput && oldInput.gender === 'Male') ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= (oldInput && oldInput.gender === 'Female') ? 'selected' : '' %>>Female</option>
            <option value="Transgender" <%= (oldInput && oldInput.gender === 'Transgender') ? 'selected' : '' %>>Transgender</option>
            <option value="Prefer not to say" <%= (oldInput && oldInput.gender === 'Prefer not to say') ? 'selected' : '' %>>Prefer not to say</option>
          </select>
          <% if (errors.gender) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.gender %></div>
          <% } %>
        </div>

        <!-- Date of Birth -->
        <div class="pu-form-group pu-col-3">
          <label for="dob" class="pu-label">Date of Birth <span class="required">*</span></label>
          <input type="date" id="dob" name="dob" class="pu-input <%= errors.dob ? 'is-invalid' : '' %>" value="<%= oldInput.dob || '' %>" required>
          <% if (errors.dob) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.dob %></div>
          <% } %>
        </div>

        <!-- Age (Calculated) -->
        <div class="pu-form-group pu-col-2">
          <label for="age" class="pu-label">Age</label>
          <input type="number" id="age" name="age" class="pu-input pu-input-readonly" value="<%= oldInput.age || '' %>" readonly placeholder="Auto">
        </div>

        <!-- Blood Group -->
        <div class="pu-form-group pu-col-4">
          <label for="blood_group" class="pu-label">Blood Group <span class="required">*</span></label>
          <select id="blood_group" name="blood_group" class="pu-select <%= errors.blood_group ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Blood Group --</option>
            <% bloodGroups.forEach(function(bg) { %>
              <option value="<%= bg %>" <%= (oldInput && oldInput.blood_group === bg) ? 'selected' : '' %>><%= bg %></option>
            <% }); %>
          </select>
          <% if (errors.blood_group) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.blood_group %></div>
          <% } %>
        </div>

        <!-- Aadhaar Number -->
        <div class="pu-form-group pu-col-6">
          <label for="aadhaar_number" class="pu-label">Aadhaar Number <span class="required">*</span></label>
          <input type="text" id="aadhaar_number" name="aadhaar_number" class="pu-input <%= errors.aadhaar_number ? 'is-invalid' : '' %>" value="<%= oldInput.aadhaar_number || '' %>" placeholder="12-digit Aadhaar Number" maxlength="12" required>
          <small class="pu-help-text">Numeric 12-digit unique ID.</small>
          <% if (errors.aadhaar_number) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.aadhaar_number %></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 3: ADDRESS DETAILS -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-location-dot"></i> 3. Address Details</h3>
    </div>
    <div class="pu-card-body">
      <div class="pu-form-grid">

        <!-- Native State / UT -->
        <div class="pu-form-group pu-col-12">
          <label for="native_state" class="pu-label">Native State / Union Territory <span class="required">*</span></label>
          <select id="native_state" name="native_state" class="pu-select <%= errors.native_state ? 'is-invalid' : '' %>" required>
            <option value="">-- Select Native State / UT --</option>
            <% states.forEach(function(st) { %>
              <option value="<%= st %>" <%= (oldInput && oldInput.native_state === st) ? 'selected' : '' %>><%= st %></option>
            <% }); %>
          </select>
          <% if (errors.native_state) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.native_state %></div>
          <% } %>
        </div>

        <!-- Present Address -->
        <div class="pu-form-group pu-col-6">
          <label for="present_address" class="pu-label">Present Address <span class="required">*</span></label>
          <textarea id="present_address" name="present_address" class="pu-textarea <%= errors.present_address ? 'is-invalid' : '' %>" rows="4" placeholder="Hostel / Local Address in Puducherry" required><%= oldInput.present_address || '' %></textarea>
          <% if (errors.present_address) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.present_address %></div>
          <% } %>
        </div>

        <!-- Permanent Address -->
        <div class="pu-form-group pu-col-6">
          <div class="pu-address-copy-wrapper">
            <label for="permanent_address" class="pu-label">Permanent Address <span class="required">*</span></label>
            <label class="pu-checkbox-inline">
              <input type="checkbox" id="is_same_address" name="is_same_address" value="1" <%= (oldInput && (oldInput.is_same_address === '1' || oldInput.is_same_address === 'on')) ? 'checked' : '' %>>
              Same as Present Address
            </label>
          </div>
          <textarea id="permanent_address" name="permanent_address" class="pu-textarea <%= errors.permanent_address ? 'is-invalid' : '' %>" rows="4" placeholder="Home / Native Address" required><%= oldInput.permanent_address || '' %></textarea>
          <% if (errors.permanent_address) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.permanent_address %></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 4: LANGUAGE PROFICIENCY -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-language"></i> 4. Language Proficiency</h3>
    </div>
    <div class="pu-card-body">
      <p class="pu-instruction-text">Select all languages you can speak, read, or write <span class="required">*</span></p>
      <div class="pu-checkbox-grid">
        <% languages.forEach(function(lang) { 
          let isChecked = false;
          if (oldInput && oldInput.languages_spoken) {
            if (Array.isArray(oldInput.languages_spoken)) {
              isChecked = oldInput.languages_spoken.includes(lang);
            } else if (oldInput.languages_spoken === lang) {
              isChecked = true;
            }
          }
        %>
          <label class="pu-checkbox-card">
            <input type="checkbox" name="languages_spoken" value="<%= lang %>" <%= isChecked ? 'checked' : '' %>>
            <span><%= lang %></span>
          </label>
        <% }); %>
      </div>
      <% if (errors.languages_spoken) { %>
        <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.languages_spoken %></div>
      <% } %>
    </div>
  </div>

  <!-- SECTION 5: NSS INFORMATION -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-award"></i> 5. NSS Volunteer Information</h3>
    </div>
    <div class="pu-card-body">
      <div class="pu-form-grid">

        <!-- Previous Volunteer Question -->
        <div class="pu-form-group pu-col-12">
          <label class="pu-label">Have you been an NSS Volunteer previously (School/College)? <span class="required">*</span></label>
          <div class="pu-radio-group">
            <label class="pu-radio-label">
              <input type="radio" name="is_previous_volunteer" value="Yes" <%= (oldInput && oldInput.is_previous_volunteer === 'Yes') ? 'checked' : '' %> required>
              Yes
            </label>
            <label class="pu-radio-label">
              <input type="radio" name="is_previous_volunteer" value="No" <%= (!oldInput || !oldInput.is_previous_volunteer || oldInput.is_previous_volunteer === 'No') ? 'checked' : '' %>>
              No
            </label>
          </div>
          <% if (errors.is_previous_volunteer) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.is_previous_volunteer %></div>
          <% } %>
        </div>

        <!-- Certificate Upload Container (Conditional) -->
        <div class="pu-form-group pu-col-12" id="certificateUploadContainer" style="display: <%= (oldInput && oldInput.is_previous_volunteer === 'Yes') ? 'block' : 'none' %>;">
          <label for="certificate" class="pu-label">Upload Previous NSS Certificate <span class="required">*</span></label>
          <input type="file" id="certificate" name="certificate" class="pu-file-input <%= errors.certificate ? 'is-invalid' : '' %>" accept=".pdf,.jpg,.jpeg">
          <small class="pu-help-text">Accepted formats: PDF, JPG, JPEG | Maximum file size: <strong>250 KB</strong>.</small>
          <% if (errors.certificate) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.certificate %></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 6: NSS PU MEDIA TEAM -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-camera-retro"></i> 6. NSS PU Media Team Preference</h3>
    </div>
    <div class="pu-card-body">
      <div class="pu-form-grid">

        <!-- Interested in Media Team -->
        <div class="pu-form-group pu-col-12">
          <label class="pu-label">Are you interested in joining the NSS PU Media Team? <span class="required">*</span></label>
          <div class="pu-radio-group">
            <label class="pu-radio-label">
              <input type="radio" name="interested_in_media" value="Yes" <%= (oldInput && oldInput.interested_in_media === 'Yes') ? 'checked' : '' %> required>
              Yes
            </label>
            <label class="pu-radio-label">
              <input type="radio" name="interested_in_media" value="No" <%= (!oldInput || !oldInput.interested_in_media || oldInput.interested_in_media === 'No') ? 'checked' : '' %>>
              No
            </label>
          </div>
          <% if (errors.interested_in_media) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.interested_in_media %></div>
          <% } %>
        </div>

        <!-- Media Team Roles Selection (Conditional) -->
        <div class="pu-form-group pu-col-12" id="mediaRolesContainer" style="display: <%= (oldInput && oldInput.interested_in_media === 'Yes') ? 'block' : 'none' %>;">
          <p class="pu-instruction-text">Select your preferred Media Team Role(s) <span class="required">*</span></p>
          <div class="pu-checkbox-grid">
            <% mediaRoles.forEach(function(role) { 
              let isChecked = false;
              if (oldInput && oldInput.media_roles) {
                if (Array.isArray(oldInput.media_roles)) {
                  isChecked = oldInput.media_roles.includes(role);
                } else if (oldInput.media_roles === role) {
                  isChecked = true;
                }
              }
            %>
              <label class="pu-checkbox-card">
                <input type="checkbox" name="media_roles" value="<%= role %>" <%= isChecked ? 'checked' : '' %>>
                <span><%= role %></span>
              </label>
            <% }); %>
          </div>
          <% if (errors.media_roles) { %>
            <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.media_roles %></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 7: DECLARATION -->
  <div class="pu-card">
    <div class="pu-card-header">
      <h3 class="pu-card-title"><i class="fa-solid fa-file-contract"></i> 7. Declaration</h3>
    </div>
    <div class="pu-card-body">
      <div class="declaration-box">
        <p>
          I hereby declare that all the information furnished in this registration form is true, complete, and correct to the best of my knowledge and belief. I understand that if any information is found to be false or incorrect at any stage, my volunteer registration with the National Service Scheme (NSS), Pondicherry University is liable to be cancelled immediately without notice. I pledge to adhere to the code of conduct and principles of NSS: <strong>"NOT ME BUT YOU"</strong>.
        </p>
      </div>
      <div class="pu-form-group margin-top-md">
        <label class="pu-checkbox-inline declaration-checkbox-label">
          <input type="checkbox" id="declaration_accepted" name="declaration_accepted" value="1" <%= (oldInput && (oldInput.declaration_accepted === '1' || oldInput.declaration_accepted === 'on')) ? 'checked' : '' %> required>
          <strong>I agree to the terms and conditions and confirm that all details provided above are accurate.</strong>
        </label>
        <% if (errors.declaration_accepted) { %>
          <div class="pu-error-feedback"><i class="fa-solid fa-circle-exclamation"></i> <%= errors.declaration_accepted %></div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Submit Button Action Bar -->
  <div class="pu-form-actions">
    <button type="reset" class="pu-btn pu-btn-secondary"><i class="fa-solid fa-rotate-left"></i> Reset Form</button>
    <button type="button" id="openSubmitModalBtn" class="pu-btn pu-btn-primary" disabled>
      <i class="fa-solid fa-paper-plane"></i> Review & Submit Registration
    </button>
  </div>

</form>

<%- include('partials/footer') %>