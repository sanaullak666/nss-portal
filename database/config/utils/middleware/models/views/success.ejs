<%- include('partials/header') %>

<div class="pu-success-wrapper">
  <div class="pu-card pu-success-card">
    <div class="pu-card-body text-center">
      
      <div class="pu-success-icon-wrapper">
        <i class="fa-solid fa-circle-check"></i>
      </div>

      <h2 class="pu-success-title">Registration Submitted Successfully!</h2>
      <p class="pu-success-subtitle">
        Thank you, <strong><%= registration.applicant_name %></strong>. Your application for National Service Scheme (NSS), Pondicherry University has been successfully recorded.
      </p>

      <div class="pu-reg-id-box">
        <span class="pu-reg-id-label">OFFICIAL REGISTRATION ID</span>
        <div class="pu-reg-id-value" id="regIdText"><%= registration.registration_id %></div>
        <button type="button" class="pu-btn pu-btn-sm pu-btn-outline" id="copyRegIdBtn" onclick="copyRegistrationId()">
          <i class="fa-regular fa-copy"></i> Copy Registration ID
        </button>
      </div>

      <div class="pu-alert pu-alert-info text-left margin-top-lg">
        <i class="fa-solid fa-circle-info"></i>
        <div>
          <strong>Important Instructions:</strong>
          <ul class="pu-success-instructions">
            <li>Please preserve your <strong>Registration ID</strong> for future correspondence, orientation scheduling, and certificate issuance.</li>
            <li>An official confirmation email has been logged for <strong><%= registration.email %></strong>.</li>
            <li>Your application has been assigned to <strong><%= registration.unit_number %></strong> under the <strong><%= registration.department %></strong>.</li>
          </ul>
        </div>
      </div>

      <div class="pu-summary-table-wrapper margin-top-lg text-left">
        <h4 class="pu-summary-heading"><i class="fa-solid fa-receipt"></i> Application Summary Snapshot</h4>
        <table class="pu-table pu-table-bordered">
          <tbody>
            <tr>
              <th width="35%">Applicant Name</th>
              <td><%= registration.applicant_name %></td>
            </tr>
            <tr>
              <th>University Reg / App No</th>
              <td><%= registration.univ_reg_no %></td>
            </tr>
            <tr>
              <th>Assigned NSS Unit</th>
              <td><span class="pu-badge pu-badge-primary"><%= registration.unit_number %></span></td>
            </tr>
            <tr>
              <th>Course & Year</th>
              <td><%= registration.course %> (<%= registration.year_of_study %>)</td>
            </tr>
            <tr>
              <th>Contact Number</th>
              <td><%= registration.contact_number %></td>
            </tr>
            <tr>
              <th>Submission Date</th>
              <td><%= formattedDate %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Actions & External Integrations -->
      <div class="pu-success-actions">
        <a href="<%= whatsappGroupLink %>" target="_blank" rel="noopener noreferrer" class="pu-btn pu-btn-whatsapp">
          <i class="fa-brands fa-whatsapp"></i> Join Official NSS WhatsApp Group
        </a>
        <button type="button" class="pu-btn pu-btn-secondary" onclick="window.print()">
          <i class="fa-solid fa-print"></i> Print Confirmation
        </button>
        <a href="/" class="pu-btn pu-btn-outline">
          <i class="fa-solid fa-house"></i> Return to Homepage
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  function copyRegistrationId() {
    const regId = document.getElementById('regIdText').innerText.trim();
    navigator.clipboard.writeText(regId).then(function() {
      const btn = document.getElementById('copyRegIdBtn');
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
      btn.classList.add('pu-btn-success');
      setTimeout(function() {
        btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy Registration ID';
        btn.classList.remove('pu-btn-success');
      }, 2500);
    }).catch(function(err) {
      console.error('Copy failed:', err);
    });
  }
</script>

<%- include('partials/footer') %>